rew run(
  (
    (entity "example_and" is
      port (("A" : in 'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;
    end "example_and" ) ;
    (architecture "behaviour" of "example_and" is 
      (
        signal "A" : bit := stdlogicVal('0') ;
      )
      begin (
            ("B" <= (stdlogicVal('0') or "A")) ;
            ("C" <= (stdlogicVal('0') or "B")) ;
      )
    end "behaviour" );
  ), {scheduledEvent: time (5 ns), args {sgName "A", value stdlogicVal('1')}}) .