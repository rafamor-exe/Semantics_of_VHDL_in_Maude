rew run(
  (
    (entity "plus_5" is
      port (("B" : inout  integer ;) ("C" : inout  integer ;)  ) ;
    end "plus_5" ) ;
    (architecture "behaviour" of "plus_5" is 
      (
        signal "A" : integer := intVal(10) ;
      )
      begin (
            (sg("B") <= (sg("A") + intVal(5))) ;
            (sg("C") <= (sg("B") + intVal(5))) ;
      )
    end "behaviour" );
  )) .