rew run(
  (
    (entity "example" is
      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;
    end "example" ) ;
    (architecture "behaviour" of "example" is 
      begin (
            sg("B") <= sg("A") ;
            sg("C") <= sg("B") ;
      )
    end "behaviour" );
  )) .