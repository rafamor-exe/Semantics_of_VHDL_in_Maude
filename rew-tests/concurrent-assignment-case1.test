rew run(
  (
    (entity "example_and" is
      port (("A" : in  bit ;)  ("B" : in  "std_logic" ;) ("C" : in  "std_logic" ;)  ) ;
    end "example_and" ) ;
    (architecture "behaviour" of "example_and" is nop ;
      begin (
          process "A" begin
            (("B" <= (stdlogicVal('0') or "A")) ;
            ("C" <= (stdlogicVal('0') or "B")) ;)
          end process ;
      )
    end "behaviour" );
  ), nil) .