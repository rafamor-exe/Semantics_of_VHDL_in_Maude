rew run(
  (
    (entity "multiple_delays" is
      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;
    end "multiple_delays" ) ;
    (architecture "behaviour" of "multiple_delays" is 
      (
        signal "A" : bit := stdlogicVal('0') ;
      )
      begin (
          process nil begin
            (
              (
                if ("A" = stdlogicVal('1')) then
                (
                  ("B" <= (stdlogicVal('0') or "A")) ;
                  ("C" <= (stdlogicVal('0') or "B")) ;
                )
                else
                (
                  ("A" <= stdlogicVal('1') after (5 ns)) ;
                  ("B" <= stdlogicVal('0') after (5 ns)) ;
                )
                end if
              ) ;
            )
          end process ;
      )
    end "behaviour" );
  ), empty) .