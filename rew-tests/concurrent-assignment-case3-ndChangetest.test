rew run(
  (
    (entity "example_and" is
      port (("B" : inout  'std_logic ;) ("C" : out  'std_logic ;)  ) ;
    end "example_and" ) ;
    (architecture "behaviour" of "example_and" is 
      (
        signal "A" : bit := stdlogicVal('0') ;
      )
      begin (
          process "A" begin
            (
              ("B" <= (stdlogicVal('0') or "A")) ;
              ("C" <= (stdlogicVal('0') or "B")) ;
            )
          end process ;
      )
    end "behaviour" );
  ), {scheduledEvent: time (5 ns), args {sgName "A", value stdlogicVal('1')}}, true) .