*** Delayed assignments different time
search run(  (    (entity "multiple_delays" is      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;    end "multiple_delays" ) ;    (architecture "behaviour" of "multiple_delays" is       (        signal "A" : 'std_logic := stdlogicVal('0') ;      )      begin (          process nil begin            (              (                if (sg("A") = stdlogicVal('1')) then                (                  (sg("B") <= (stdlogicVal('0') or sg("A"))) ;                  (sg("C") <= (stdlogicVal('0') or sg("B"))) ;                )                else                (                  (sg("A") <= transport stdlogicVal('1') after (5 ns)) ;                  (sg("B") <= transport stdlogicVal('0') after (6 ns)) ; (sg("C") <= transport stdlogicVal('0') after (7 ns)) ;                )                end if              ) ;            )          end process ;      )    end "behaviour" );  )) =>! v:VHDLCompleteSim .

*** Scheduled assignment events different time
search run(  (    (entity "example_and" is      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;    end "example_and" ) ;    (architecture "behaviour" of "example_and" is       (        signal "A" : 'std_logic := stdlogicVal('0') ;      )      begin (          process sg("A") begin            (              (                if (sg("A") = stdlogicVal('1')) then                (                  (sg("B") <= (stdlogicVal('0') or sg("A"))) ;                  (sg("C") <= (stdlogicVal('0') or sg("B"))) ;                )                end if              ) ;            )          end process ;      )    end "behaviour" );  ), ({scheduledEvent: time (5 ns), args {sgName sg("A"), value stdlogicVal('1')}} {scheduledEvent: time (6 ns), args {sgName sg("B"), value stdlogicVal('1')}} {scheduledEvent: time (7 ns), args {sgName sg("C"), value stdlogicVal('0')}})) =>! v:VHDLCompleteSim .

*** Delayed assignments same time
*** - There is a bifurcation on when deciding which event to take first
*** - NOTE: They converge to the same final state (because for this specific case the order is not important at the end)
search run(  (    (entity "multiple_delays" is      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;    end "multiple_delays" ) ;    (architecture "behaviour" of "multiple_delays" is       (        signal "A" : 'std_logic := stdlogicVal('0') ;      )      begin (          process nil begin            (              (                if (sg("A") = stdlogicVal('1')) then                (                  (sg("B") <= (stdlogicVal('0') or sg("A"))) ;                  (sg("C") <= (stdlogicVal('0') or sg("B"))) ;                )                else                (                  (sg("A") <= transport stdlogicVal('1') after (5 ns)) ;                  (sg("B") <= transport stdlogicVal('0') after (5 ns)) ; (sg("C") <= transport stdlogicVal('0') after (5 ns)) ;               )                end if              ) ;            )          end process ;      )    end "behaviour" );  )) =>! v:VHDLCompleteSim .

*** Scheduled assignment events same time
*** - There is a bifurcation on when deciding which event to take first
*** - NOTE: They converge to the same final state (because for this specific case the order is not important at the end)
search run(  (    (entity "example_and" is      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;    end "example_and" ) ;    (architecture "behaviour" of "example_and" is       (        signal "A" : 'std_logic := stdlogicVal('0') ;      )      begin (          process sg("A") begin            (              (                if (sg("A") = stdlogicVal('1')) then                (                  (sg("B") <= (stdlogicVal('0') or sg("A"))) ;                  (sg("C") <= (stdlogicVal('0') or sg("B"))) ;                )                end if              ) ;            )          end process ;      )    end "behaviour" );  ), ({scheduledEvent: time (5 ns), args {sgName sg("A"), value stdlogicVal('1')}} {scheduledEvent: time (5 ns), args {sgName sg("B"), value stdlogicVal('1')}})) =>! v:VHDLCompleteSim .
