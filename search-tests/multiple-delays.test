*** Delayed assignments different time
search run(  (    (entity "multiple_delays" is      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;    end "multiple_delays" ) ;    (architecture "behaviour" of "multiple_delays" is       (        signal "A" : bit := stdlogicVal('0') ;      )      begin (          process nil begin            (              (                if ("A" = stdlogicVal('1')) then                (                  ("B" <= (stdlogicVal('0') or "A")) ;                  ("C" <= (stdlogicVal('0') or "B")) ;                )                else                (                  ("A" <= stdlogicVal('1') after (5 ns)) ;                  ("B" <= stdlogicVal('0') after (6 ns)) ;                )                end if              ) ;            )          end process ;      )    end "behaviour" );  ), empty) =>! v:VHDLCompleteSim .

*** Scheduled assignment events different time
search run(  (    (entity "example_and" is      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;    end "example_and" ) ;    (architecture "behaviour" of "example_and" is       (        signal "A" : bit := stdlogicVal('0') ;      )      begin (          process "A" begin            (              (                if ("A" = stdlogicVal('1')) then                (                  ("B" <= (stdlogicVal('0') or "A")) ;                  ("C" <= (stdlogicVal('0') or "B")) ;                )                end if              ) ;            )          end process ;      )    end "behaviour" );  ), ({scheduledEvent: time (5 ns), args {sgName "A", value stdlogicVal('1')}}, {scheduledEvent: time (6 ns), args {sgName "B", value stdlogicVal('1')}})) =>! v:VHDLCompleteSim .

*** Delayed assignments same time
*** - There is a bifurcation on when deciding which event to take first
*** - NOTE: They converge to the same final state (because for this specific case the order is not important at the end)
search run(  (    (entity "multiple_delays" is      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;    end "multiple_delays" ) ;    (architecture "behaviour" of "multiple_delays" is       (        signal "A" : bit := stdlogicVal('0') ;      )      begin (          process nil begin            (              (                if ("A" = stdlogicVal('1')) then                (                  ("B" <= (stdlogicVal('0') or "A")) ;                  ("C" <= (stdlogicVal('0') or "B")) ;                )                else                (                  ("A" <= stdlogicVal('1') after (5 ns)) ;                  ("B" <= stdlogicVal('0') after (5 ns)) ;                )                end if              ) ;            )          end process ;      )    end "behaviour" );  ), empty) =>! v:VHDLCompleteSim .

*** Scheduled assignment events same time
*** - There is a bifurcation on when deciding which event to take first
*** - NOTE: They converge to the same final state (because for this specific case the order is not important at the end)
search run(  (    (entity "example_and" is      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;    end "example_and" ) ;    (architecture "behaviour" of "example_and" is       (        signal "A" : bit := stdlogicVal('0') ;      )      begin (          process "A" begin            (              (                if ("A" = stdlogicVal('1')) then                (                  ("B" <= (stdlogicVal('0') or "A")) ;                  ("C" <= (stdlogicVal('0') or "B")) ;                )                end if              ) ;            )          end process ;      )    end "behaviour" );  ), ({scheduledEvent: time (5 ns), args {sgName "A", value stdlogicVal('1')}}, {scheduledEvent: time (5 ns), args {sgName "B", value stdlogicVal('1')}})) =>! v:VHDLCompleteSim .