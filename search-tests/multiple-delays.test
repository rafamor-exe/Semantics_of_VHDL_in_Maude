*** Delayed assignments different time
search run(  (    (entity "multiple_delays" is      port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;    end "multiple_delays" ) ;    (architecture "behaviour" of "multiple_delays" is       (        signal "A" : 'std_logic := stdlogicVal('0') ;      )      begin (          process nil begin            (              (                if (sg("A") = stdlogicVal('1')) then                (                  (sg("B") <= (stdlogicVal('0') or sg("A"))) ;                  (sg("C") <= (stdlogicVal('0') or sg("B"))) ;                )                else                (                  (sg("A") <= transport stdlogicVal('1') after (5 ns)) ;                  (sg("B") <= transport stdlogicVal('0') after (6 ns)) ; (sg("C") <= transport stdlogicVal('0') after (7 ns)) ;                )                end if              ) ;            )          end process ;      )    end "behaviour" );  )) =>! v:VHDLCompleteSim .


search [, 48] run(      (            (entity "multiple_delays" is                  port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;)  ) ;    end "multiple_delays" ) ;    (architecture "behaviour" of "multiple_delays" is           (signal "A" : 'std_logic := stdlogicVal('0') ;           )        begin (            process nil begin                (                  (                    (sg("B") <= sg("A") after (2000000 fs));                                       )                 )            end process ;        )    end "behaviour" );  ), {scheduledEvent: time (3000000 fs), args {sgName sg("A"), value stdlogicVal('1')}} {scheduledEvent: time (7000000 fs), args {sgName sg("A"), value stdlogicVal('0')}} {scheduledEvent: time (8000000 fs), args {sgName sg("A"), value stdlogicVal('1')}})   =>! v:VHDLCompleteSim .

*** At 9000000 fs, B should be 1 as the transition should have been purged when A turns 1 at 8000000 fs
search run(
      (
            (entity "multiple_delays" is
                  port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;)  ) ;    end "multiple_delays" ) ;
    (architecture "behaviour" of "multiple_delays" is
           (
                    signal "A" : 'std_logic := stdlogicVal('0') ;
           )
        begin (
            process nil begin
                (
                  (
                    (sg("B") <= sg("A") after (2000000 fs));
                   ) 
                )
            end process ;
        )
    end "behaviour" );
  ), {scheduledEvent: time (3000000 fs), args {sgName sg("A"), value stdlogicVal('1')}} {scheduledEvent: time (7000000 fs), args {sgName sg("A"), value stdlogicVal('0')}} {scheduledEvent: time (8000000 fs), args {sgName sg("A"), value stdlogicVal('1')}})
   =>! v:VHDLCompleteSim .


search run(
      (
            (entity "multiple_delays" is
                  port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;)  ) ;    end "multiple_delays" ) ;
    (architecture "behaviour" of "multiple_delays" is
           (
                    signal "A" : 'std_logic := stdlogicVal('0') ;
           )
        begin (
            process nil begin
                (
                  (
                    (sg("B") <= sg("A") after (2000000 fs));
                   ) 
                )
            end process ;
        )
    end "behaviour" );
  ), {scheduledEvent: time (3000000 fs), args {sgName sg("A"), value stdlogicVal('1')}} {scheduledEvent: time (7000000 fs), args {sgName sg("A"), value stdlogicVal('0')}} {scheduledEvent: time (8000000 fs), args {sgName sg("A"), value stdlogicVal('1')}})
   =>* < clk(R1 fs) [prev: clk(Tprev)] | nil >< Tsect:TimeControlSection > StoresVar {repeat: SgChangedMap } {wholeExec: SchList} ! {inputChangeSimCtrl: B, Tany:Time} such that R1 == 8000000 .

search run(
      (
            (entity "multiple_delays" is
                  port (("A" : in  'std_logic ;)  ("B" : inout  'std_logic ;) ("C" : inout  'std_logic ;)  ) ;    end "multiple_delays" ) ;
    (architecture "behaviour" of "multiple_delays" is
           (
                    signal "A" : 'std_logic := stdlogicVal('0') ;
           )
        begin (
            process nil begin
                (
                  (
                    if (sg("A") = stdlogicVal('1')) then
                    (
                      (sg("B") <= (sg("A"))) ;
                      (sg("C") <= (sg("B"))) ;
                    )
                    else
                    (
                    (sg("A") <= stdlogicVal('1') after (5 ns)) ;
                    (sg("A") <= stdlogicVal('0') after (1 ns)) ;
                    (sg("B") <= stdlogicVal('0') after (6 ns)) ;
                    (sg("C") <= stdlogicVal('0') after (7 ns)) ;
                    )
                    end if
                   ) ;
                )
            end process ;
        )
    end "behaviour" );
  )) =>! v:VHDLCompleteSim .

