fmod VHDL-IODEF-MOD is

  protecting STRING .

  sorts IODef IOType IOValues SgDesc .

  ops in out inout : -> IOType [ctor] .
  ops "std_logic" bit integer time : -> IOValues [ctor] .

  op {_$_} : IOType IOValues -> SgDesc [ctor] .

  op _:__; : String IOType IOValues -> IODef [ctor] .

endfm

view IODef from TRIV to VHDL-IODEF-MOD is
  sort Elt to IODef .
endv

view SgDesc from TRIV to VHDL-IODEF-MOD is
  sort Elt to SgDesc .
endv

view IOType from TRIV to VHDL-IODEF-MOD is
  sort Elt to IOType .
endv

fmod VHDL-VALUE-MOD is

  protecting RAT .
  protecting STRING .
  protecting VHDL-IODEF-MOD .

  sorts StdLogic Value IntVal StdLogicVal TimeVal NatVal PosVal BoolVal .
  sorts Time TimeUnit TimeDelta Delta Bit StdLogicAux .
  sorts To1 To0 .
  subsorts BoolVal PosVal NatVal IntVal StdLogicVal TimeVal < Value . *** checkear. añadir un wrapper a los tipos
  subsorts Bit StdLogicAux < StdLogic < StdLogicVal .
  subsorts TimeDelta < Time .

  op bitVal : Bit -> StdLogicVal [ctor] .
  op intVal : Int -> IntVal [ctor] .
  op stdlogicVal : StdLogic -> StdLogicVal [ctor] .
  op timeVal : Time -> TimeVal [ctor] .
  op natVal : Nat -> NatVal [ctor] .
  op posVal : NzNat -> PosVal [ctor] .
  op boolVal : Bool -> BoolVal [ctor] .

  ops TRUE FALSE : -> BoolVal [ctor] .
  eq TRUE = boolVal(true) .
  eq FALSE = boolVal(false) .

  *** Bit logic

  ops '0' '1' : -> Bit [ctor] .
  ops 'Z' 'W' 'L' 'H' : -> StdLogicAux [ctor] .
  ops 'U' 'X' '-' : -> StdLogic [ctor] .

  *** Time

  ops hr min sec ms us ns ps fs : -> TimeUnit [ctor] .
  op __ : Rat TimeUnit -> Time [ctor] .

  *** operations will be done with fs
  op to-fs : Time -> Time [ctor] .

  var R : Rat .
  eq to-fs(R fs) = R fs .
  eq to-fs(R ps) = to-fs((R * 1000) fs) .
  eq to-fs(R ns) = to-fs((R * 1000) ps) .
  eq to-fs(R us) = to-fs((R * 1000) ns) .
  eq to-fs(R ms) = to-fs((R * 1000 ) us) .
  eq to-fs(R sec) = to-fs((R * 1000) ms) .
  eq to-fs(R min) = to-fs((R * 60) sec) .
  eq to-fs(R hr) = to-fs((R * 60) min) .

  *** Delta delays
  op delta : Nat -> Delta [ctor] .
  op delta : -> Delta [ctor] .
  eq delta = delta(1) .
  op _ + _ : Time Delta -> TimeDelta [ctor] .

  op _+_ : Delta Delta -> Delta [assoc comm ctor] .

  vars TDelta1 TDelta2 : Delta .
  var T : Time .
  vars N1 N2 : Nat .
  eq delta(N1) + delta(N2) = delta(N1 + N2) .
  eq (T + TDelta1) + TDelta2 = T + (TDelta1 + TDelta2) .

  op default : IOValues -> Value .
  eq default("std_logic") = stdlogicVal('U') .
  eq default(bit) = stdlogicVal('0') .

  ***var StdLogic : StdLogic .
  ***mb 'H' : To1 .
  ***mb '1' : To1 . 
  ***mb 'L' : To0 .
  ***mb '0' : To0 . 

endfm

view Value from TRIV to VHDL-VALUE-MOD is
  sort Elt to Value .
endv


fmod VHDL-GENERIC-MOD is

  protecting STRING .
  protecting VHDL-VALUE-MOD .

  sorts GenDef VarType .

  op _: _ := _; : String VarType Value -> GenDef [ctor] .
  ops natural integer time positive : -> VarType [ctor] .

endfm

view GenDef from TRIV to VHDL-GENERIC-MOD is
  sort Elt to GenDef .
endv

fmod VHDL-INSTCOLON-MOD is

  protecting VHDL-IODEF-MOD .
  protecting VHDL-VALUE-MOD .
  protecting VHDL-GENERIC-MOD .
  protecting LIST{IODef} .
  protecting LIST{GenDef} .
  

  sorts Inst InstColon EntityInst EntityInstColon Port SignalName VarConstName SgDecl SgAssign AExp Term Op CompOp Generic .
  subsorts Port Generic < EntityInst .
  subsorts EntityInst SgDecl SgAssign < Inst .
  *** The following order causes Advisory messages on loading the module
  ***subsorts EntityInstColon < InstColon .
  subsorts String < SignalName VarConstName .
  subsorts Value < AExp .

  ops and or nand nor xnor xor : -> Op [ctor] . 
  ops = /= < > "<=" ">=" : -> CompOp [ctor] .
  ***op _ _ _ : Term Op AExp -> AExp [ctor] .

  vars Op : Op .
  vars SignalId : SignalName .
  var EntityI : EntityInst .

  op _; : Inst -> InstColon [ctor].
  ***mb (EntityI ;) : EntityInstColon .
  ***op _; : EntityInst -> EntityInstColon [ctor] .

  *** Instruction ops declarations (no dependency on instruction lists)
  *** - Test nop
  op nop : -> Inst [ctor] .
  *** - Port
  op port (_) : NeList{IODef} -> Port [ctor] .
  *** - Generic
  op generic (_) : NeList{GenDef} -> Generic [ctor] .

  vars StdLogicVal StdLogicVal1 StdLogicVal2 : StdLogicVal .
  vars BoolVal BoolVal1 BoolVal2 : BoolVal .
  vars B1 B2 : Bool .
  var ZWLH : StdLogicAux .
  var To0 : To0 .
  var To1 : To1 .
  vars AExp1 AExp2 : AExp .

  op ___ : AExp Op AExp -> AExp [ctor] .
  op ___ : AExp CompOp AExp -> BoolVal [ctor] .

  op not_ : AExp -> AExp [ctor] .
  eq not stdlogicVal('U') = stdlogicVal('U') .
  eq not stdlogicVal('0') = stdlogicVal('1') .
  eq not stdlogicVal('1') = stdlogicVal('0') .
  eq not stdlogicVal('L') = stdlogicVal('1') .
  eq not stdlogicVal('H') = stdlogicVal('0') .
  eq not StdLogicVal = stdlogicVal('X') [owise] .
  ***Bool op definition
  eq not boolVal(B1) = boolVal(not B1) .

  ***op _or_ : StdLogic AExp -> AExp [ctor] .
  eq stdlogicVal('1') or AExp1 = stdlogicVal('1') .
  eq stdlogicVal('H') or AExp1 = stdlogicVal('1') .
  eq AExp1 or stdlogicVal('1') = stdlogicVal('1') .
  eq AExp1 or stdlogicVal('H') = stdlogicVal('1') .
  eq stdlogicVal('0') or stdlogicVal('L') = stdlogicVal('0') .
  eq stdlogicVal('L') or stdlogicVal('0') = stdlogicVal('0') .
  eq stdlogicVal('0') or stdlogicVal('0') = stdlogicVal('0') .
  eq stdlogicVal('L') or stdlogicVal('L') = stdlogicVal('0') .
  eq stdlogicVal('U') or StdLogicVal2 = orU(StdLogicVal2) . 
  eq StdLogicVal1 or stdlogicVal('U') = orU(StdLogicVal1) .
  eq StdLogicVal1 or StdLogicVal2 = stdlogicVal('X') [owise] .
  ***Bool op definition
  eq boolVal(B1) or boolVal(B2) = boolVal(B1 or B2) .

  op orU : StdLogicVal -> StdLogicVal .
  eq orU('1') = stdlogicVal('1') .
  eq orU('H') = stdlogicVal('1') .
  eq orU(StdLogicVal) = stdlogicVal('U') [owise] .

  ***op _and_ : StdLogic AExp -> AExp [ctor] .
  eq stdlogicVal('1') and stdlogicVal('H') = stdlogicVal('1') .
  eq stdlogicVal('H') and stdlogicVal('1') = stdlogicVal('1') .
  eq stdlogicVal('0') and AExp1 =  stdlogicVal('0') .
  eq stdlogicVal('L') and AExp1 =  stdlogicVal('0') .
  eq AExp1 and stdlogicVal('0') =  stdlogicVal('0') .
  eq AExp1 and stdlogicVal('L') =  stdlogicVal('0') .
  eq stdlogicVal('U') and StdLogicVal2 = andU(StdLogicVal2) . 
  eq StdLogicVal1 and stdlogicVal('U') = andU(StdLogicVal1) .
  eq StdLogicVal1 and StdLogicVal2 = stdlogicVal('X') [owise] .
  ***Bool op definition
  eq boolVal(B1) and boolVal(B2) = boolVal(B1 and B2) .

  op andU : StdLogicVal -> StdLogicVal .
  eq orU('0') = stdlogicVal('0') .
  eq orU('L') = stdlogicVal('0') .
  eq orU(StdLogicVal) = stdlogicVal('U') [owise] .

  ***op _xor_ : AExp AExp -> AExp [ditto ctor] .
  ***ceq AExp1 xor AExp2 = stdlogicVal('1') if AExp1 =/= AExp2 /\ (AExp1 == stdlogicVal('1') or AExp2 == stdlogicVal('1')) .
  ***eq AExp1 xor AExp2 =  stdlogicVal('0') [owise] .
  eq stdlogicVal('1') xor stdlogicVal('0') = stdlogicVal('1') .
  eq stdlogicVal('0') xor stdlogicVal('1') = stdlogicVal('1') .
  eq stdlogicVal('1') xor stdlogicVal('L') = stdlogicVal('1') .
  eq stdlogicVal('L') xor stdlogicVal('1') = stdlogicVal('1') .
  eq stdlogicVal('1') xor stdlogicVal('1') = stdlogicVal('0') .
  eq stdlogicVal('1') xor stdlogicVal('H') = stdlogicVal('0') .
  eq stdlogicVal('H') xor stdlogicVal('1') = stdlogicVal('0') .
  eq stdlogicVal('H') xor stdlogicVal('H') = stdlogicVal('0') .
  eq stdlogicVal('0') xor stdlogicVal('0') = stdlogicVal('0') .
  eq stdlogicVal('0') xor stdlogicVal('L') = stdlogicVal('0') .
  eq stdlogicVal('L') xor stdlogicVal('0') = stdlogicVal('0') .
  eq stdlogicVal('L') xor stdlogicVal('L') = stdlogicVal('0') .
  eq stdlogicVal('U') xor AExp1 = stdlogicVal('U') . 
  eq AExp1 xor stdlogicVal('U') = stdlogicVal('U') .
  eq StdLogicVal1 xor StdLogicVal2 = stdlogicVal('X') [owise] .
  ***Bool op definition
  eq boolVal(B1) xor boolVal(B2) = boolVal(B1 xor B2) .


  ***op _xand_ : AExp AExp -> AExp [ctor] .
  eq AExp1 nand AExp2 = not (AExp1 and AExp2) .
  eq AExp1 nor AExp2 = not (AExp1 or AExp2) .
  eq AExp1 xnor AExp2 = not (AExp1 xor AExp2) .

  ***ceq StdLogicVal1 sg-xor AExp2 = stdlogicVal('1') if StdLogicVal1 =/= AExp2 /\ (StdLogicVal1 == stdlogicVal('1') or AExp2 == stdlogicVal('1')) .
  ***eq StdLogicVal1 sg-xor StdLogicVal2 =  StdLogicVal1 xor StdLogicVal2 [owise] .

  op _ <= _ : SignalName AExp -> SgAssign [ctor] .

  *** Resolve multiple values on the same delta. Based on STD_LOGIC standard.
  op resolve : StdLogicVal StdLogicVal -> StdLogicVal .
  eq resolve(stdlogicVal('U'), StdLogicVal2) = stdlogicVal('U') .
  eq resolve(StdLogicVal1, stdlogicVal('U')) = stdlogicVal('U') .
  eq resolve(stdlogicVal('0'), stdlogicVal(ZWLH)) = stdlogicVal('0') .
  eq resolve(stdlogicVal(ZWLH), stdlogicVal('0')) = stdlogicVal('0') .
  eq resolve(stdlogicVal('1'), stdlogicVal(ZWLH)) = stdlogicVal('1') .
  eq resolve(stdlogicVal(ZWLH), stdlogicVal('1')) = stdlogicVal('1') .
  eq resolve(stdlogicVal('Z'), stdlogicVal(ZWLH)) = stdlogicVal(ZWLH) .
  eq resolve(stdlogicVal(ZWLH), stdlogicVal('Z')) = stdlogicVal(ZWLH) .
  eq resolve(stdlogicVal('W'), stdlogicVal(ZWLH)) = stdlogicVal('W') .
  eq resolve(stdlogicVal(ZWLH), stdlogicVal('W')) = stdlogicVal('W') .
  eq resolve(stdlogicVal('L'), stdlogicVal('H')) = stdlogicVal('W') .
  eq resolve(stdlogicVal('H'), stdlogicVal('L')) = stdlogicVal('W') .
  eq resolve(StdLogicVal1, StdLogicVal2) = stdlogicVal('X') [owise] .

  eq (StdLogicVal1 = StdLogicVal2) = boolVal(StdLogicVal1 == StdLogicVal2) .
  eq (StdLogicVal1 /= StdLogicVal2) = boolVal(StdLogicVal1 =/= StdLogicVal2) .

  eq (BoolVal1 = BoolVal2) = boolVal(BoolVal1 == BoolVal2) .
  eq (BoolVal1 /= BoolVal2) = boolVal(BoolVal1 =/= BoolVal2) .
  eq (boolVal(false) < boolVal(true)) = boolVal(true) .
  eq (BoolVal1 < BoolVal2) = boolVal(false) [owise] .
  eq (boolVal(false) "<=" BoolVal2) = boolVal(true) .
  eq (BoolVal1 "<=" BoolVal2) = boolVal(false) [owise] .
  eq (boolVal(true) > boolVal(false)) = boolVal(true) .
  eq (BoolVal1 > BoolVal2) = boolVal(false) [owise] .
  eq (boolVal(true) ">=" BoolVal2) = boolVal(true) .
  eq (BoolVal1 ">=" BoolVal2) = boolVal(false) [owise] .

endfm

view InstColon from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to InstColon .
endv

view EntityInstColon from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to EntityInstColon .
endv

view SignalName from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to SignalName .
endv

fmod VHDL-SCHEDULE-MOD is

  protecting VHDL-VALUE-MOD .
  protecting VHDL-INSTCOLON-MOD .

  sorts ScheduledInst SgTimeTuple Transaction SignalState .

  *** An ScheduledInst contains the instruction to be executed and the delay
  *** TODO: check if it would be more accurate to just delay an assignment (delay,sg,value)
  op {scheduledInst: time _, inst _} : Time InstColon -> ScheduledInst [ctor] .

  *** Transactions (ScheduledEvents) relate time and value for a certain signal
  op {sgName _, value _} : SignalName Value -> SignalState [ctor] .
  op {scheduledEvent: time _, args _} : Time SignalState -> Transaction [ctor] .

  op {sgName _, time _} : SignalName Time -> SgTimeTuple [ctor] .

endfm

view ScheduledInst from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to ScheduledInst .
endv

view SgTimeTuple from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to SgTimeTuple .
endv

view Transaction from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to Transaction .
endv

mod VHDLMOD is
  *** RAFAEL MORALES PALACIOS - SEMANTICS OF VHDL IN MAUDE
  
  *** IMPORT DATATYPE MODULES TO BE USED
  protecting NAT .
  ***protecting INT .
  ***protecting STRING .
  protecting VHDL-INSTCOLON-MOD .
  protecting VHDL-VALUE-MOD .
  protecting VHDL-GENERIC-MOD .
  protecting MAP{String, Value} .
  protecting MAP{SgTimeTuple, Value} .
  protecting MAP{String, SgDesc} .
  protecting MAP{String, Bool} .
  protecting LIST{InstColon} .
  protecting LIST{EntityInstColon} .
  protecting LIST{SignalName} .
  protecting LIST{ScheduledInst} .
  protecting LIST{Transaction} .
  protecting LIST{IOType} .
  protecting LIST{SignalName} .
  
  *** Declare sorts to be used and hierarchy between them.
  sorts VHDLSim VHDLBareSim VHDLCompleteSim Parser ParserTime ParserInsts Code Signal Var Const Clock SimClock ClockPrev Und Error Entity Architecture SgDescStore TimeControlSection ValueStores DescStores . ***sorts VHDLSim Code Entity Port Signal SignalName Var Const VarConstName Value Architecture Process Clock ScheduledInst Und Error .
  sorts Process ProcessSensitivity ProcessNoSensitivity .
  sorts SeqStatement .
  sorts IfThen EndIf ElsifStatement ElseStatement NullStatement .
  sorts EmptyList InstBlock StructuredInstList . ***sorts Inst EmptyList NeList{Inst} List{Inst} InstBlock StructuredInstList .
  sorts EventSchList .
  sorts NeScheduleList ScheduleList NeListeningList ListeningList .
  sorts Assign SignalAssign VarConstAssign .
  sorts Stores NeStore SignalStore VarStore ConstStore .
  sorts EmptyStore NeSignalStore NeVarStore NeConstStore .


  *** Simulator components
  subsorts Code < VHDLBareSim .

  subsorts ProcessSensitivity ProcessNoSensitivity < Process .
  subsorts Entity Architecture Process Error SeqStatement < Inst .
  subsorts IfThen < SeqStatement .
  subsorts NullStatement < ElsifStatement ElseStatement .

  op und : -> Und [ctor] .
  op EmptyList : -> EmptyList [ctor] .
  op error : String -> Error [ctor] .

  op _||_||_ : List{ScheduledInst} List{SignalName} List{Transaction} -> TimeControlSection [ctor] .
  op << _ | _ | _ >> : Map{SgTimeTuple, Value} Map{String, Value} Map{String, Value} -> ValueStores [ctor] .
  op < _ > : Map{String, SgDesc} -> DescStores [ctor] .

  op _ # _ : ValueStores DescStores -> Stores [ctor] .

  op [_->_] : List{InstColon} List{ScheduledInst} -> ParserInsts [ctor] .

  op _ _ : ParserInsts Stores -> Parser [ctor] .
  op _ < events: _ > : Parser List{Transaction} -> ParserTime [ctor] .

  *** Code represents a whole VHDL file. Rules will be needed for each code statement/block
  op <_|_><_>_ : SimClock List{InstColon} TimeControlSection Stores -> VHDLBareSim [ctor] .
  op _ {repeat: _} {wholeExec: _} : VHDLBareSim Map{String, Bool} List{ScheduledInst} -> VHDLCompleteSim [ctor] .

  op clk : Time -> Clock [ctor] .
  op [prev: _] : Clock -> ClockPrev [ctor] .
  op _ _ : Clock ClockPrev -> SimClock [ctor] .

  *** null is an internal representation for a lack of statement (placeholder)
  op null : -> NullStatement [ctor] .

  *** Instruction ops declarations (that include inner instruction lists)
  
  *** - Entity
  op entity _ is _ end _ : String List{InstColon} String -> Entity [ctor] .
  op entity _ is end _ : String String -> Entity [ctor] .
  
  *** - Architecture
  op architecture _ of _ is _ begin _ end _ : String String List{InstColon} List{InstColon} String -> Architecture [ctor] .
  
  *** - Process
  *** TODO: Variable assignment possibility before begin not included
  op process _ begin _ end process : List{SignalName} List{InstColon} -> ProcessSensitivity [ctor] .
  op process begin _ end process : List{InstColon} -> ProcessNoSensitivity [ctor] .
  op end process : -> Inst [ctor] .

  *** - If statement
  *** TODO: defined precedence
  ***       - Example: red if true then nop ; (elsif true then nop ; elsif true then nop ;) else nop ; end if 
  op end if : -> EndIf [ctor] .
  op if _ then _ _ _ _ : BoolVal List{InstColon} ElsifStatement ElseStatement EndIf -> IfThen [ctor] .
  op if _ then _ _ _ : BoolVal List{InstColon} ElseStatement EndIf -> IfThen [ctor] .
  op if _ then _ _ _ : BoolVal List{InstColon} ElsifStatement EndIf -> IfThen [ctor] .
  op if _ then _ _ : BoolVal List{InstColon} EndIf -> IfThen [ctor] .
  op elsif _ then _ _ : BoolVal List{InstColon} ElsifStatement -> ElsifStatement [ctor] .
  op elsif _ then _ : BoolVal List{InstColon} -> ElsifStatement [ctor] .
  op else _ : List{InstColon} -> ElseStatement [ctor] .
  


  *** - Signal (declaration)
  op signal _:_ : NeList{SignalName} IOValues -> SgDecl [ctor] .


  *** lookup: auxiliar op to lookup values from signal store
  op lookup : Map{String, Value} String -> Value .
  *** lookup-sg must be an eq to be able to evaluate it everywhere
  op lookup-sg : Map{SgTimeTuple, Value} SgTimeTuple -> Value .

  *** final_state: final state reachable when max time elapsed is reached
  *** op final_state : VHDLSim -> FinalState .


  *** Variable definition

  vars I1 S1 : InstColon .
  vars SignalId SignalId1 SignalId2 : SignalName .
  var Val Value Value1 Value2 : Value .
  var IL IL1 IL2 : List{InstColon} .
  var NeIL1 NeIL2 : NeList{InstColon} .
  var SgSTR : Map{SgTimeTuple, Value} .
  var SgTimeTuple : SgTimeTuple .
  var STR VarSTR ConstSTR : Map{String, Value} .
  var SgDescSTR : Map{String, SgDesc} .
  var SgDesc : SgDesc .
  var Int1 Int2 : Int .
  var Str Str2 : String .
  var Clk : SimClock .
  var ClkP1 ClkP2 : Clock .
  var N : Nat .
  var NVal : NatVal .
  var Int : Int .
  var IntVal : IntVal .
  var SchList SchListCp : List{ScheduledInst} .
  var EventSchList : List{Transaction} .
  var LstList : List{SignalName} .
  var NeIODefL : NeList{IODef} .
  var IODef : IODef .
  var IOType : IOType .
  var IOTypeL : List{IOType} .
  var IOValues : IOValues .
  var IODefL : List{IODef} .
  var StdLogicVal StdLogicVal1 StdLogicVal2 : StdLogicVal .
  var AExp1 : AExp .
  var Error : Error .
  vars Op : Op .
  var VarType : VarType .
  var NeGenDefL : NeList{GenDef} .
  var GenDefL : List{GenDef} .
  var EntityIL : List{EntityInstColon} .
  vars T Tprev Tnext Tnow : Time .
  var ClockPrev : ClockPrev .
  var TVal : TimeVal .
  var PosVal : PosVal .
  var NeSgNameL : NeList{SignalName} .
  var SgNameL : List{SignalName} .
  var TControlSect : TimeControlSection .
  var ValStores : ValueStores .
  var SignalState : SignalState .
  var StoresVar : Stores .
  var DescStores : DescStores .
  var B : Bool .
  var SgChangedMap : Map{String, Bool} .
  var SignalIdL : List{SignalName} .
  var ElsifSt : ElsifStatement .
  var ElseSt : ElseStatement .
  var EndIf : EndIf .
  var CompOp : CompOp .
  var BoolVal : BoolVal .

  *** Workflow: run(IL, EventSchList) -> Parse -> insitSimArch -> Simulation Loop
  op run : List{InstColon} List{Transaction} -> VHDLCompleteSim [ctor] .
  eq run(IL, EventSchList) = initSimArch(parse(IL) < events: EventSchList >) .

  op parse : List{InstColon} -> Parser [ctor] .
  eq parse(IL) = [ IL -> nil ] << empty | empty | empty >> # < empty > .

  op initSimArch : ParserTime -> VHDLCompleteSim [ctor] .
  eq initSimArch([ nil -> SchList ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > < events: EventSchList >) = < clk(0 ns) [prev: clk(0 ns)] | nil >< SchList || nil || EventSchList > << insertDefault(SgDescSTR, SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insertDefaultRep(SgDescSTR, empty) } {wholeExec: SchList} .

  op insertDefault : Map{String, SgDesc} Map{SgTimeTuple, Value} -> Map{SgTimeTuple, Value} .
  eq insertDefault(SignalId |-> { IOType $ IOValues }, SgSTR) = insert({sgName SignalId, time 0 ns}, default(IOValues),  SgSTR) .
  eq insertDefault((SignalId |-> { IOType $ IOValues }, SgDescSTR), SgSTR) = insert({sgName SignalId, time 0 ns}, default(IOValues),  insertDefault(SgDescSTR, SgSTR)) .

  op insertDefaultRep : Map{String, SgDesc} Map{String, Bool} -> Map{String, Bool} .
  eq insertDefaultRep(SignalId |-> { IOType $ IOValues }, SgChangedMap) = insert(SignalId, false,  SgChangedMap) .
  eq insertDefaultRep((SignalId |-> { IOType $ IOValues }, SgDescSTR), SgChangedMap) = insert(SignalId, false,  insertDefaultRep(SgDescSTR, SgChangedMap)) .

  ***op initSim : List{InstColon} List{Transaction} -> VHDLSim [ctor] .
  ***eq initSim(IL, EventSchList) = < clk(0 ns) [prev: clk(0 ns)] | IL >< nil | nil | EventSchList > << empty | empty | empty >> # < empty > .

  *** An entity declared without instructions is equivalent to an entity with an empty list of instructions
  eq entity Str is end Str = entity Str is nil end Str .
  *** A process declared without a sensitivity list is equal to the process with an empty sensitivity list 
  eq process begin IL end process = process nil begin IL end process .
  
  *** An if statement can have any number of elsif sub-statements and 0 or 1 else statements
  eq if BoolVal then IL EndIf = if BoolVal then IL null null EndIf .
  eq if BoolVal then IL ElseSt EndIf = if BoolVal then IL null ElseSt EndIf .
  eq if BoolVal then IL ElsifSt EndIf = if BoolVal then IL ElsifSt null EndIf .
  eq elsif BoolVal then IL = elsif BoolVal then IL null .

  *** TODO: Restrict values of SgSTR to StdLogic with cmb

  *** Rules

  *** Non-deterministic change of signal values
  *** TODO:
  *** - Optionality
  *** - Restrict where it could happen
  *** - Take into account that when activating
  ***rl [nd-sg-val-change] : < clk(T) [prev: clk(Tprev)] | nil >< SchList || LstList || EventSchList > << ({sgName SignalId, time T} |-> StdLogicVal , SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp}
  ***                        => 
  ***                        < clk(T) [prev: clk(Tprev)] | nil >< SchList || LstList || EventSchList > << insert({sgName SignalId, time T + delta}, correctVal(not StdLogicVal, SignalId, lookup-sg(SgSTR, {sgName SignalId, time T + delta}), lookup-sg(SgSTR, {sgName SignalId, time T})), SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalId,  (sg-val-changed(correctVal(not StdLogicVal, SignalId, lookup-sg(SgSTR, {sgName SignalId, time T + delta}), lookup-sg(SgSTR, {sgName SignalId, time T})), SignalId, T, SgSTR)), SgChangedMap) } {wholeExec: SchListCp} .

  rl [parse-entity] : [ (entity Str is IL1 end Str) ; IL -> SchList ]
                      => 
                      [ IL1 exit-block(IL) -> SchList ] .

  rl [parse-port] : [ (port(NeIODefL)) ; IL -> SchList ]
                    => 
                    [ get-port-sg(NeIODefL) ; exit-block(IL) -> SchList ] .
  rl [parse-get-port-sg] : [ (get-port-sg((Str : IOType IOValues ;) IODefL)) ; exit-block(IL) -> SchList ] ValStores # < SgDescSTR > 
                     => 
                     [ get-port-sg(IODefL) ; exit-block(IL) -> SchList ] ValStores # < insert(Str, { IOType $ IOValues }, SgDescSTR) > .

  rl [parse-generic] : [ (generic(NeGenDefL)) ; IL -> SchList ]
                => 
                [ get-gen(NeGenDefL) ; exit-block(IL) -> SchList ] .
  crl [parse-get-gen] : [ (get-gen((Str : VarType := Val ;) GenDefL)) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | ConstSTR >> # DescStores
                =>
                [ get-gen(GenDefL) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | insert(Str, Val, ConstSTR) >> # DescStores 
                if verify-gen(VarType, Val) .

  rl [parse-signal] : [ (signal NeSgNameL : IOValues) ; IL -> SchList ]
                => 
                [ decl-sg(NeSgNameL, IOValues) ; exit-block(IL) -> SchList ] .
  
  rl [parse-decl-sg] : [ decl-sg(SignalId SgNameL, IOValues) ; exit-block(IL) -> SchList ] ValStores # < SgDescSTR >
                =>
                [ decl-sg(SgNameL, IOValues) ; exit-block(IL) -> SchList ] ValStores # < insert(SignalId, { inout $ IOValues}, SgDescSTR) > .

  rl [parse-architecture] : [ (architecture Str of Str2 is IL1 begin IL2 end Str) ; IL -> SchList ] StoresVar
                          => 
                          [ IL1 exit-block(IL2 exit-block(IL)) -> SchList ] StoresVar .  
                          
  rl [parse-process] : [ (process SgNameL begin IL2 end process) ; IL -> SchList ]
                    => 
                    [ IL -> SchList {scheduledInst: time 0 ns, inst (process SgNameL begin IL2 end process) ;} ] .

  crl [parse-assign-sg-val] : [ (SignalId <= AExp1) ; IL -> SchList ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > 
                            => 
                            [ IL -> SchList {scheduledInst: time 0 ns, inst (SignalId <= AExp1) ;} ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > 
                            if verify-sg(out inout, SignalId, SgDescSTR) .

  *** assign-sg-val : assign a value to a signal after solving all AExp and signal lookups
  rl [assign-sg-val-sch] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (SignalId <= Value) ;}  SchList || LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp}
                      => 
                      < clk(T) [prev: clk(Tprev)] | nil >< SchList || LstList || EventSchList > << insert({sgName SignalId, time T + delta}, correctVal(Value, SignalId, lookup-sg(SgSTR, {sgName SignalId, time T + delta}), lookup-sg(SgSTR, {sgName SignalId, time T})), SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalId,  (sg-val-changed(correctVal(Value, SignalId, lookup-sg(SgSTR, {sgName SignalId, time T + delta}), lookup-sg(SgSTR, {sgName SignalId, time T})), SignalId, T, SgSTR)), SgChangedMap) } {wholeExec: SchListCp} .

  rl [resolve-sg] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (SignalId <= SignalId1 Op AExp1) ;}  SchList || LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # DescStores {repeat: SgChangedMap } {wholeExec: SchListCp}
                    => 
                  < clk(T) [prev: clk(Tprev)] | nil >< SchList || LstList || EventSchList > << insert({sgName SignalId, time T + delta}, correctVal(lookup-sg(SgSTR, {sgName SignalId1, time T}) Op AExp1, SignalId, lookup-sg(SgSTR, {sgName SignalId, time T + delta}), lookup-sg(SgSTR, {sgName SignalId, time T})), SgSTR) | VarSTR | ConstSTR >> # DescStores {repeat: insert(SignalId,  (sg-val-changed(correctVal(lookup-sg(SgSTR, {sgName SignalId1, time T}) Op AExp1, SignalId, lookup-sg(SgSTR, {sgName SignalId, time T + delta}), lookup-sg(SgSTR, {sgName SignalId, time T})), SignalId, T, SgSTR)), SgChangedMap) } {wholeExec: SchListCp} .
  
  rl [resolve-sg-bis] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (SignalId <= AExp1 Op SignalId1) ;}  SchList || LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # DescStores {repeat: SgChangedMap } {wholeExec: SchListCp}
                    => 
                  < clk(T) [prev: clk(Tprev)] | nil >< SchList || LstList || EventSchList > << insert({sgName SignalId, time T + delta}, correctVal(AExp1 Op lookup-sg(SgSTR, {sgName SignalId1, time T}), SignalId, lookup-sg(SgSTR, {sgName SignalId, time T + delta}), lookup-sg(SgSTR, {sgName SignalId, time T})), SgSTR) | VarSTR | ConstSTR >> # DescStores {repeat: insert(SignalId,  (sg-val-changed(correctVal(AExp1 Op lookup-sg(SgSTR, {sgName SignalId1, time T}), SignalId, lookup-sg(SgSTR, {sgName SignalId, time T + delta}), lookup-sg(SgSTR, {sgName SignalId, time T})), SignalId , T, SgSTR)), SgChangedMap) } {wholeExec: SchListCp} .

  rl [process] : < clk(T) ClockPrev | nil >< {scheduledInst: time T, inst (process SgNameL begin IL2 end process) ;}  SchList || LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # DescStores 
                => 
                if processSensitivityActivate(clk(T) ClockPrev, SgNameL, SgSTR)
                then
                  < clk(T) ClockPrev | nil >< unfold(IL2, T) SchList || SgNameL LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # DescStores
                else
                 < clk(T) ClockPrev | nil >< SchList || SgNameL LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # DescStores
                fi .
  rl [if-then] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (if BoolVal then IL ElsifSt ElseSt EndIf) ;}  SchList || LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # DescStores {repeat: SgChangedMap } {wholeExec: SchListCp}
                => 
                if (evalB(BoolVal, T, SgSTR) == boolVal(true)) then
                  < clk(T) [prev: clk(Tprev)] | nil >< unfold(IL, T) SchList || LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # DescStores {repeat: SgChangedMap } {wholeExec: SchListCp}
                else
                  < clk(T) [prev: clk(Tprev)] | nil >< unfold(schRestIf(ElsifSt, ElseSt), T) SchList || LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # DescStores {repeat: SgChangedMap } {wholeExec: SchListCp}
                fi .

  ***rl [end-parse] : [ nil -> SchList ] StoresVar < events: EventSchList >
  ***                =>
  ***                initSimArch([ nil -> SchList ] StoresVar < events: EventSchList >) .

  crl [end-sim-cycle-delta] : < clk(T) [prev: clk(Tprev)] | nil >< nil || LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp}
                                    => 
                                    < clk(T + delta) [prev: clk(T)] | nil >< schOnTime(SchListCp, T + delta) || nil || EventSchList > << fill-blanks(get-sgL(SgDescSTR), SgSTR, T + delta, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insertDefaultRep(SgDescSTR, SgChangedMap) } {wholeExec: SchListCp}
                                    if anySgChange(SgChangedMap) == true .
  crl [end-sim-cycle-delta-nextEv] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time Tnext, inst I1 } SchList || LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp}
                            => 
                            < clk(T + delta) [prev: clk(T)] | nil >< schOnTime(SchListCp, T + delta) {scheduledInst: time Tnext, inst I1 } SchList || nil || EventSchList > << fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insertDefaultRep(SgDescSTR, SgChangedMap) } {wholeExec: SchListCp}
                            if anySgChange(SgChangedMap) == true and T =/= Tnext .
  crl [end-sim-cycle-nextEv] : < clk(T) [prev: clk(Tprev)] | nil >< nil || LstList || {scheduledEvent: time Tnext, args {sgName SignalId, value Value} } EventSchList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp}
                            => 
                            < clk(Tnext) [prev: clk(T)] | nil >< schOnTime(SchListCp, Tnext) || nil || EventSchList > << fill-blanks-next-ev(SignalId, get-sgL(SgDescSTR), insert({sgName SignalId, time Tnext}, Value, fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalId, true, SgChangedMap) } {wholeExec: SchListCp}
                            if anySgChange(SgChangedMap) == false and T =/= Tnext .
  ***rl [end-sim] : < clk(T) [prev: clk(Tprev)] | nil >< nil || LstList || EventSchList > << SgSTR | VarSTR | ConstSTR >> # DescStores {repeat: B } {wholeExec: SchListCp}
  ***              => 
  ***              < clk(T) [prev: clk(T)] | nil >< nil || nil || EventSchList > << SgSTR | VarSTR | ConstSTR >> # DescStores {repeat: B } {wholeExec: SchListCp} .
                            
    
  
  rl [lookup-sg] :  < ClkP1 [prev: clk(T)] | (SignalId <= SignalId1 Op AExp1) ; IL >< TControlSect > << SgSTR | VarSTR | ConstSTR >> # DescStores 
                  => 
                  < ClkP1 [prev: clk(T)] | (SignalId <= lookup-sg(SgSTR, {sgName SignalId1, time T}) Op AExp1) ; IL >< TControlSect > << SgSTR | VarSTR | ConstSTR >> # DescStores .
                  
  rl [lookup-sg-bis] :  < ClkP1 [prev: clk(T)] | (SignalId <= AExp1 Op SignalId1) ; IL >< TControlSect > << SgSTR | VarSTR | ConstSTR >> # DescStores 
                => 
                < ClkP1 [prev: clk(T)] | (SignalId <= AExp1 Op lookup-sg(SgSTR, {sgName SignalId1, time T})) ; IL >< TControlSect > << SgSTR | VarSTR | ConstSTR >> # DescStores .


  *** nop: test instruction
  rl [nop] : nop ; IL => IL .


  *** exit-block: exit an inner block and continue where left before
  rl [exit-block] : < Clk | exit-block(IL) >< TControlSect > ValStores # DescStores 
                    => 
                    < Clk | IL >< TControlSect > ValStores # DescStores .
  
  rl [parse-exit-block] : [ exit-block(IL) -> SchList ]
                => 
                [ IL -> SchList ] .

  ***rl [error] : < Clk | Error ; IL >< TControlSect > ValStores # DescStores => Error ; .

  *** List{Inst} operations 
  op head : NeList{InstColon} -> InstColon .
  eq head(I1 IL) = I1 .

  op tail : NeList{InstColon} -> List{InstColon} .
  eq tail(I1 IL) = IL .

  op exit-block : List{InstColon} -> List{InstColon} .
  ***eq exit-block(IL) = IL .

  op get-port-sg : List{IODef} -> Inst [ctor] .
  eq get-port-sg(nil) = nop .

  op get-sgtype : SgDesc -> IOType .
  eq get-sgtype({IOType $ IOValues}) = IOType .

  op get-gen : List{GenDef} -> Inst [ctor] .
  eq get-gen(nil) = nop .

  op decl-sg : List{SignalName} IOValues -> Inst [ctor] .
  eq decl-sg(nil, IOValues) = nop .

  op unfold : List{InstColon} Time -> List{ScheduledInst} [ctor] .
  eq unfold(nil, T) = nil .
  eq unfold(I1 IL, T) = {scheduledInst: time T, inst I1} unfold(IL, T) .

  op processSensitivityActivate : SimClock List{SignalName} Map{SgTimeTuple, Value} -> Bool .
  eq processSensitivityActivate(Clk, nil, SgSTR) = true .
  eq processSensitivityActivate(clk(0 ns) [prev: clk(0 ns)], NeSgNameL, SgSTR) = true .
  eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], SignalId1, SgSTR) = lookup-sg(SgSTR, {sgName SignalId1, time T}) =/= lookup-sg(SgSTR, {sgName SignalId1, time Tprev}) .
  eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], SignalId1 NeSgNameL, SgSTR) = processSensitivityActivate(clk(T) [prev: clk(Tprev)], SignalId1, SgSTR) or processSensitivityActivate(clk(T) [prev: clk(Tprev)], NeSgNameL, SgSTR) .
  eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], NeSgNameL, SgSTR) = false [owise] .

  op sg-val-changed : Value SignalName Time Map{SgTimeTuple, Value} -> Bool .
  eq sg-val-changed(Value, SignalId, T, SgSTR) = (Value =/= lookup-sg(SgSTR, {sgName SignalId, time T})) .
  ***eq sg-val-changed(Value, SignalId, T, SgSTR) = false [owise] .

  op schOnTime : List{ScheduledInst} Time -> List{ScheduledInst} [ctor] .
  eq schOnTime(nil, Tnow) = nil .
  eq schOnTime({scheduledInst: time T, inst I1 } SchList, Tnow) =  {scheduledInst: time Tnow, inst I1 } schOnTime(SchList, Tnow) .

  *** TODO: stdlogicval2 not needed?
  op correctVal : Value SignalName Value Value -> Value .
  eq correctVal(Value, SignalId, undefined, undefined) = Value .
  eq correctVal(Value, SignalId, undefined, Value2) = Value .
  eq correctVal(Value, SignalId, Value, Value2) = Value .
  ***if lookup-sg(SgSTR, {sgName SignalId, time T + delta}) == undefined or lookup-sg(SgSTR, {sgName SignalId, time T}) == stdlogicVal('U') .
  eq correctVal(Value, SignalId, Value1, Value2) = resolve(Value, Value1) [owise] .

  op anySgChange : Map{String, Bool} -> Bool .
  eq anySgChange(empty) = false .
  eq anySgChange((SignalId |-> true, SgChangedMap)) = true .
  eq anySgChange((SignalId |-> false, SgChangedMap)) = anySgChange(SgChangedMap) .

  op fill-blanks : List{SignalName} Map{SgTimeTuple, Value} Time Time -> Map{SgTimeTuple, Value} .
  eq fill-blanks(nil, SgSTR, T, Tprev) = SgSTR .
  ceq fill-blanks(SignalId1 SignalIdL, SgSTR, T, Tprev) = insert({sgName SignalId1, time T}, SgSTR[{sgName SignalId1, time Tprev}], fill-blanks(SignalIdL, SgSTR, T, Tprev)) if SgSTR[{sgName SignalId1, time T}] == undefined .
  eq fill-blanks(SignalId1 SignalIdL, SgSTR, T, Tprev) = fill-blanks(SignalIdL, SgSTR, T, Tprev) .

  op fill-blanks-next-ev : SignalName List{SignalName} Map{SgTimeTuple, Value} Time Time -> Map{SgTimeTuple, Value} .
  eq fill-blanks-next-ev(SignalId, nil, SgSTR, Tnext, T) = SgSTR .
  eq fill-blanks-next-ev(SignalId, SignalId SignalIdL, SgSTR, Tnext, T) = fill-blanks-next-ev(SignalId, SignalIdL, SgSTR, Tnext, T) .
  ceq fill-blanks-next-ev(SignalId, SignalId1 SignalIdL, SgSTR, Tnext, T) = insert({sgName SignalId1, time Tnext}, SgSTR[{sgName SignalId1, time T}], fill-blanks(SignalIdL, SgSTR, Tnext, T)) if SgSTR[{sgName SignalId1, time Tnext}] == undefined and SignalId =/= SignalId1 .
  eq fill-blanks-next-ev(SignalId, SignalId1 SignalIdL, SgSTR, Tnext, T) = fill-blanks-next-ev(SignalId, SignalIdL, SgSTR, Tnext, T) [owise] .

  op get-sgL : Map{String, SgDesc} -> List{SignalName} .
  eq get-sgL(empty) = nil .
  eq get-sgL((SignalId |-> SgDesc, SgDescSTR)) = SignalId get-sgL(SgDescSTR) .

  op schRestIf : ElsifStatement ElseStatement -> List{InstColon} .
  eq schRestIf(null, null) = nil .
  eq schRestIf(null, else IL) = IL .
  eq schRestIf(elsif boolVal(true) then IL ElsifSt, ElseSt) = IL .
  eq schRestIf(elsif boolVal(false) then IL ElsifSt, ElseSt) = schRestIf(ElsifSt, ElseSt) .


  *** ------------

  op ___ : SignalName Op AExp -> AExp [ctor] .
  ***eq SignalId Op AExp1 = lookup-sg(SignalId, SgSTR) Op AExp1 .
  op ___ : AExp Op SignalName -> AExp [ctor] .
  ***eq AExp1 Op SignalId = AExp1 Op lookup-sg(SignalId, SgSTR) .
  op ___ : SignalName Op SignalName -> AExp [ctor] .
  ***eq SignalId1 Op SignalId2 = lookup-sg(SignalId1) Op lookup-sg(SignalId2, SgSTR) .

  *** Needed specific declaration for xor due to collisions
  ***op _xor_ : SignalName AExp -> AExp [ctor] .
  ***op _xor_ : AExp SignalName -> AExp [ctor] .
  ***eq SignalId xor AExp1 = lookup-sg(SignalId, SgSTR) xor AExp1 .
  ***eq SignalId xor AExp1 = SignalId sg-xor AExp1 .
  ***eq AExp1 xor SignalId = AExp1 sg-xor SignalId .
  ***op _xor_ : AExp SignalName -> AExp [ctor] .
  ***eq AExp1 xor SignalId = AExp1 xor lookup-sg(SignalId) .
  op not _ : SignalName -> AExp [ctor] .
  eq not SignalId = stdlogicVal('1') xor SignalId .

  op ___ : SignalName CompOp AExp -> BoolVal [ctor] .
  ***eq SignalId CompOp AExp1 = lookup-sg(SgSTR, SignalId) CompOp AExp1 .
  op ___ : AExp CompOp SignalName -> BoolVal [ctor] .
  ***eq AExp1 Op SignalId = AExp1 Op lookup-sg(SignalId, SgSTR) .
  op ___ : SignalName CompOp SignalName -> BoolVal [ctor] .
  
  *** lookup signal from signal store
  eq lookup-sg(SgSTR, SgTimeTuple) = SgSTR[SgTimeTuple] .
  eq lookup(STR, Str) = STR[Str] .

  op evalB : BoolVal Time Map{SgTimeTuple, Value} -> BoolVal .
  eq evalB(boolVal(true), T, SgSTR) = boolVal(true) .
  eq evalB(boolVal(false), T, SgSTR) = boolVal(false) .
  eq evalB(SignalId CompOp AExp1, T, SgSTR) = SgSTR[{sgName SignalId, time T}] CompOp AExp1 .
  eq evalB(AExp1 CompOp SignalId, T, SgSTR) = AExp1 CompOp SgSTR[{sgName SignalId, time T}] .
  eq evalB(SignalId1 CompOp SignalId2, T, SgSTR) = SgSTR[{sgName SignalId1, time T}] CompOp SgSTR[{sgName SignalId2, time T}] .

  ***--------------------------
  *** VERIFICATION
  ***--------------------------
  *** verify-sg: auxilar op to verify signal types on instructions
  op verify-sg : List{IOType} SignalName Map{String, SgDesc} -> Bool [ctor] .
  eq verify-sg(IOType IOTypeL, SignalId, SgDescSTR) = (IOType == get-sgtype(SgDescSTR[SignalId]) or verify-sg(IOTypeL, SignalId, SgDescSTR)) .
  eq verify-sg(IOTypeL, SignalId, SgDescSTR) = false [owise] .
  
  *** verify-gen : auxiliar op to verify generic declaration types
  op verify-gen : VarType Value -> Bool [ctor] .
  eq verify-gen(natural, NVal) = true .
  eq verify-gen(integer, IntVal) = true .
  eq verify-gen(time, TVal) = true .
  eq verify-gen(positive, PosVal) = true .
  eq verify-gen(VarType, Val) = false [owise] .

endm

