fmod VHDL-IODEF-MOD is

  protecting STRING .

  sorts IODef IOType Type SgDesc IntType PhysType .
  subsorts IntType PhysType < Type .

  ops in out inout : -> IOType [ctor] .
  ops 'std_logic bit bool : -> Type [ctor] .
  ops time : -> PhysType [ctor] .
  ops integer natural positive : -> IntType [ctor] .

  op {_$_} : IOType Type -> SgDesc [ctor] .

  op _:__; : String IOType Type -> IODef [ctor] .

endfm

view IODef from TRIV to VHDL-IODEF-MOD is
  sort Elt to IODef .
endv

view SgDesc from TRIV to VHDL-IODEF-MOD is
  sort Elt to SgDesc .
endv

view IOType from TRIV to VHDL-IODEF-MOD is
  sort Elt to IOType .
endv

fmod VHDL-VALUE-MOD is

  protecting RAT .
  ***protecting STRING .
  protecting VHDL-IODEF-MOD .

  sorts StdLogic Value IntVal StdLogicVal TimeVal NatVal PosVal BoolVal BitVal NumVal .
  sorts PhysVal Time TimeUnit TimeDelta Delta Bit StdLogicAux .
  sorts To1 To0 .
  subsorts BitVal BoolVal PosVal NatVal IntVal StdLogicVal TimeVal < Value . *** checkear. añadir un wrapper a los tipos
  subsorts Bit StdLogicAux < StdLogic < StdLogicVal .
  subsorts TimeDelta < Time .
  subsorts TimeVal < PhysVal .
  ***subsorts IntVal PhysVal < NumVal .

  op bitVal : Bit -> BitVal [ctor] .
  op intVal : Int -> IntVal [ctor] .
  op stdlogicVal : StdLogic -> StdLogicVal [ctor] .
  op timeVal : Time -> TimeVal [ctor] .
  op natVal : Nat -> NatVal [ctor] .
  op posVal : NzNat -> PosVal [ctor] .
  op boolVal : Bool -> BoolVal [ctor] .

  var BitVal : BitVal .
  var IntVal : IntVal .
  var StdLogicVal : StdLogicVal .
  var TimeVal : TimeVal .
  var BoolVal : BoolVal .
  var NatVal : NatVal .

  op get-typeVal : Value -> Type .
  eq get-typeVal(BitVal) = bit .
  eq get-typeVal(IntVal) = integer .
  eq get-typeVal(StdLogicVal) = 'std_logic .
  eq get-typeVal(TimeVal) = time .
  eq get-typeVal(BoolVal) = bool .
  eq get-typeVal(NatVal) = natural .

  ops TRUE FALSE : -> BoolVal [ctor] .
  eq TRUE = boolVal(true) .
  eq FALSE = boolVal(false) .

  *** Bit logic

  ops '0' '1' : -> Bit [ctor] .
  ops 'Z' 'W' 'L' 'H' : -> StdLogicAux [ctor] .
  ops 'U' 'X' '-' : -> StdLogic [ctor] .

  *** Time

  ops hr min sec ms us ns ps fs : -> TimeUnit [ctor] .
  op __ : Rat TimeUnit -> Time [ctor] .

  vars T T1 T2 : Time .
  vars N1 N2 : Nat .
  var TUnit : TimeUnit .
  vars TDelta1 TDelta2 : Delta .

  *** operations will be done with fs
  op to-fs : Time -> Time [ctor] .

  var R R1 R2 : Rat .
  eq to-fs((R TUnit) + TDelta1) = (R TUnit) + TDelta1 .
  eq to-fs(R fs) = R fs .
  eq to-fs(R ps) = to-fs((R * 1000) fs) .
  eq to-fs(R ns) = to-fs((R * 1000) ps) .
  eq to-fs(R us) = to-fs((R * 1000) ns) .
  eq to-fs(R ms) = to-fs((R * 1000 ) us) .
  eq to-fs(R sec) = to-fs((R * 1000) ms) .
  eq to-fs(R min) = to-fs((R * 60) sec) .
  eq to-fs(R hr) = to-fs((R * 60) min) .



  *** Delta delays
  op delta : Nat -> Delta [ctor] .
  op delta : -> Delta [ctor] .
  eq delta = delta(1) .
  op _ + _ : Time Delta -> TimeDelta [ctor] .

  op _+_ : Delta Delta -> Delta [assoc comm ctor] .

  op get-val-time : Time -> Rat .
  eq get-val-time(R TUnit) = R .
  eq get-val-time((R TUnit) + TDelta1) = R .

  eq delta(N1) + delta(N2) = delta(N1 + N2) .
  eq (T + TDelta1) + TDelta2 = T + (TDelta1 + TDelta2) .

  op min : Time Time -> Time .
  ceq min(R1 TUnit, R2 TUnit) = R1 TUnit if R1 <= R2 .
  eq min(R1 TUnit, R2 TUnit) = R2 TUnit [owise] .

  ***var StdLogic : StdLogic .
  ***mb 'H' : To1 .
  ***mb '1' : To1 . 
  ***mb 'L' : To0 .
  ***mb '0' : To0 . 

endfm

view Value from TRIV to VHDL-VALUE-MOD is
  sort Elt to Value .
endv

fmod VHDL-GENERIC-MOD is

  ***protecting STRING .
  protecting VHDL-IODEF-MOD .
  protecting VHDL-VALUE-MOD .

  sorts GenDef .

  op _: _ := _; : String Type Value -> GenDef [ctor] .
  ***ops natural integer time positive : -> VarType [ctor] .

endfm

view GenDef from TRIV to VHDL-GENERIC-MOD is
  sort Elt to GenDef .
endv

fmod VHDL-INSTCOLON-MOD is

  protecting VHDL-IODEF-MOD .
  protecting VHDL-VALUE-MOD .
  protecting VHDL-GENERIC-MOD .
  protecting LIST{IODef} .
  protecting LIST{GenDef} .
  

  sorts Inst Inst; EntityInst EntityInstColon Port SignalName VarConstName SgDecl SgAssign AExp Term Op CompOp Generic .
  sorts PhysNumBinOp NumUnOp IBinOp NumBinOp .
  subsorts Port Generic < EntityInst .
  subsorts EntityInst SgDecl SgAssign < Inst .
  *** The following order causes Advisory messages on loading the module
  ***subsorts EntityInstColon < InstColon .
  ***subsorts String < SignalName VarConstName .
  subsorts Value SignalName < AExp .
  subsorts NumBinOp < IBinOp .
  subsorts NumBinOp < PhysNumBinOp .
  subsorts CompOp < Op .

  op sg : String -> SignalName [ctor] .

  ***ops and or nand nor xnor xor : -> Op [ctor] . 
  ops = /= < > "<=" ">=" : -> CompOp [ctor] .
  ***ops -_ : IntVal -> AExp [ctor prec 20] . ***+_
  ***ops -_ : PhysVal -> AExp [ctor prec 20] . ***+_
  op abs : IntVal -> IntVal [ctor] .
  op abs : PhysVal -> PhysVal [ctor] .
  ***ops + - : -> NumBinOp [ctor] .
  ***ops * / mod rem ** : -> IBinOp [ctor] .
  ***op _ _ _ : Term Op AExp -> AExp [ctor] .

  vars Op : Op .
  vars SignalId : SignalName .
  var EntityI : EntityInst .

  op _; : Inst -> Inst; [ctor prec 24].
  ***mb (EntityI ;) : EntityInstColon .
  ***op _; : EntityInst -> EntityInstColon [ctor] .

  *** Instruction ops declarations (no dependency on instruction lists)
  *** - Test nop
  op nop : -> Inst [ctor] .
  *** - Port
  op port (_) : NeList{IODef} -> Port [ctor] .
  *** - Generic
  op generic (_) : NeList{GenDef} -> Generic [ctor] .

  op _ <= _ after _ : SignalName AExp Time -> SgAssign [ctor prec 23] .
  op _ <= _ : SignalName AExp -> SgAssign [ctor prec 23] .

  vars Value Value1 Value2 : Value .
  vars StdLogicVal StdLogicVal1 StdLogicVal2 : StdLogicVal .
  vars BoolVal BoolVal1 BoolVal2 : BoolVal .
  vars BitVal BitVal1 BitVal2 : BitVal .
  vars IntVal IntVal1 IntVal2 : IntVal .
  vars Int1 Int2 : Int .
  vars B1 B2 : Bool .
  vars Bit1 Bit2 : Bit .
  vars StdLogic StdLogic1 StdLogic2 : StdLogic .
  var ZWLH : StdLogicAux .
  var To0 : To0 .
  var To1 : To1 .
  vars AExp1 AExp2 : AExp .
  vars T T1 T2 : Time .
  vars R R1 R2 : Rat .
  vars TUnit TUnit1 TUnit2 : TimeUnit . 

  op _and_ : AExp AExp -> AExp [ctor assoc comm] .
  op _or_ : AExp AExp -> AExp [ctor assoc comm] .
  op _nand_ : AExp AExp -> AExp [ctor assoc comm] .
  op _nor_ : AExp AExp -> AExp [ctor assoc comm] .
  op _xnor_ : AExp AExp -> AExp [ctor assoc comm] .
  op _xor_ : AExp AExp -> AExp [ctor assoc comm] .
  ***op ___ : AExp Op AExp -> AExp [ctor] .
  op ___ : AExp CompOp AExp -> BoolVal [ctor] .

  op not_ : AExp -> AExp [ctor] .
  eq not bitVal('0') = bitVal('1') .
  eq not bitVal('1') = bitVal('0') .
  eq not stdlogicVal('U') = stdlogicVal('U') .
  eq not stdlogicVal('0') = stdlogicVal('1') .
  eq not stdlogicVal('1') = stdlogicVal('0') .
  eq not stdlogicVal('L') = stdlogicVal('1') .
  eq not stdlogicVal('H') = stdlogicVal('0') .
  eq not StdLogicVal = stdlogicVal('X') [owise] .
  ***Bool op definition
  eq not boolVal(B1) = boolVal(not B1) .

  ***op _or_ : StdLogic AExp -> AExp [ctor] .
  eq bitVal('1') or BitVal2 = bitVal('1') .
  eq BitVal1 or bitVal('1') = bitVal('1') .
  eq bitVal('0') or bitVal('0') = bitVal('0') .
  eq stdlogicVal('1') or StdLogicVal2 = stdlogicVal('1') .
  eq stdlogicVal('H') or StdLogicVal2 = stdlogicVal('1') .
  eq StdLogicVal1 or stdlogicVal('1') = stdlogicVal('1') .
  eq StdLogicVal1 or stdlogicVal('H') = stdlogicVal('1') .
  eq stdlogicVal('0') or stdlogicVal('L') = stdlogicVal('0') .
  eq stdlogicVal('L') or stdlogicVal('0') = stdlogicVal('0') .
  eq stdlogicVal('0') or stdlogicVal('0') = stdlogicVal('0') .
  eq stdlogicVal('L') or stdlogicVal('L') = stdlogicVal('0') .
  eq stdlogicVal('U') or StdLogicVal2 = orU(StdLogicVal2) . 
  eq StdLogicVal1 or stdlogicVal('U') = orU(StdLogicVal1) .
  eq StdLogicVal1 or StdLogicVal2 = stdlogicVal('X') [owise] .
  ***Bool op definition
  eq boolVal(B1) or boolVal(B2) = boolVal(B1 or B2) .

  op orU : StdLogicVal -> StdLogicVal .
  eq orU('1') = stdlogicVal('1') .
  eq orU('H') = stdlogicVal('1') .
  eq orU(StdLogicVal) = stdlogicVal('U') [owise] .

  ***op _and_ : StdLogic AExp -> AExp [ctor] .
  eq bitVal('0') and BitVal2 = bitVal('0') .
  eq BitVal1 and bitVal('0') = bitVal('0') .
  eq bitVal('1') and bitVal('1') = bitVal('1') .
  eq stdlogicVal('1') and stdlogicVal('H') = stdlogicVal('1') .
  eq stdlogicVal('H') and stdlogicVal('1') = stdlogicVal('1') .
  eq stdlogicVal('1') and stdlogicVal('1') = stdlogicVal('1') .
  eq stdlogicVal('H') and stdlogicVal('H') = stdlogicVal('1') .
  eq stdlogicVal('0') and StdLogicVal2 =  stdlogicVal('0') .
  eq stdlogicVal('L') and StdLogicVal2 =  stdlogicVal('0') .
  eq StdLogicVal1 and stdlogicVal('0') =  stdlogicVal('0') .
  eq StdLogicVal1 and stdlogicVal('L') =  stdlogicVal('0') .
  eq stdlogicVal('U') and StdLogicVal2 = andU(StdLogicVal2) . 
  eq StdLogicVal1 and stdlogicVal('U') = andU(StdLogicVal1) .
  eq StdLogicVal1 and StdLogicVal2 = stdlogicVal('X') [owise] .
  ***Bool op definition
  eq boolVal(B1) and boolVal(B2) = boolVal(B1 and B2) .

  op andU : StdLogicVal -> StdLogicVal .
  eq orU('0') = stdlogicVal('0') .
  eq orU('L') = stdlogicVal('0') .
  eq orU(StdLogicVal) = stdlogicVal('U') [owise] .

  ***op _xor_ : AExp AExp -> AExp [ditto ctor] .
  ***ceq AExp1 xor AExp2 = stdlogicVal('1') if AExp1 =/= AExp2 /\ (AExp1 == stdlogicVal('1') or AExp2 == stdlogicVal('1')) .
  ***eq AExp1 xor AExp2 =  stdlogicVal('0') [owise] .
  eq bitVal(Bit1) xor bitVal(Bit1) = bitVal('0') .
  eq bitVal(Bit1) xor bitVal(Bit2) = bitVal('1') [owise] .

  eq stdlogicVal('1') xor stdlogicVal('0') = stdlogicVal('1') .
  eq stdlogicVal('0') xor stdlogicVal('1') = stdlogicVal('1') .
  eq stdlogicVal('1') xor stdlogicVal('L') = stdlogicVal('1') .
  eq stdlogicVal('L') xor stdlogicVal('1') = stdlogicVal('1') .
  eq stdlogicVal('1') xor stdlogicVal('1') = stdlogicVal('0') .
  eq stdlogicVal('1') xor stdlogicVal('H') = stdlogicVal('0') .
  eq stdlogicVal('H') xor stdlogicVal('1') = stdlogicVal('0') .
  eq stdlogicVal('H') xor stdlogicVal('H') = stdlogicVal('0') .
  eq stdlogicVal('0') xor stdlogicVal('0') = stdlogicVal('0') .
  eq stdlogicVal('0') xor stdlogicVal('L') = stdlogicVal('0') .
  eq stdlogicVal('L') xor stdlogicVal('0') = stdlogicVal('0') .
  eq stdlogicVal('L') xor stdlogicVal('L') = stdlogicVal('0') .
  eq stdlogicVal('U') xor StdLogicVal2 = stdlogicVal('U') . 
  eq StdLogicVal1 xor stdlogicVal('U') = stdlogicVal('U') .
  eq StdLogicVal1 xor StdLogicVal2 = stdlogicVal('X') [owise] .
  ***Bool op definition
  eq boolVal(B1) xor boolVal(B2) = boolVal(B1 xor B2) .


  ***op _xand_ : AExp AExp -> AExp [ctor] .
  *** COmposite operators
  eq AExp1 nand AExp2 = not (AExp1 and AExp2) .
  eq AExp1 nor AExp2 = not (AExp1 or AExp2) .
  eq AExp1 xnor AExp2 = not (AExp1 xor AExp2) .

  ***ceq StdLogicVal1 sg-xor AExp2 = stdlogicVal('1') if StdLogicVal1 =/= AExp2 /\ (StdLogicVal1 == stdlogicVal('1') or AExp2 == stdlogicVal('1')) .
  ***eq StdLogicVal1 sg-xor StdLogicVal2 =  StdLogicVal1 xor StdLogicVal2 [owise] .

  *** Resolve multiple values on the same delta. Based on STD_LOGIC standard.
  op resolve : StdLogicVal StdLogicVal -> StdLogicVal .
  eq resolve(stdlogicVal('U'), StdLogicVal2) = stdlogicVal('U') .
  eq resolve(StdLogicVal1, stdlogicVal('U')) = stdlogicVal('U') .
  eq resolve(stdlogicVal('0'), stdlogicVal(ZWLH)) = stdlogicVal('0') .
  eq resolve(stdlogicVal(ZWLH), stdlogicVal('0')) = stdlogicVal('0') .
  eq resolve(stdlogicVal('1'), stdlogicVal(ZWLH)) = stdlogicVal('1') .
  eq resolve(stdlogicVal(ZWLH), stdlogicVal('1')) = stdlogicVal('1') .
  eq resolve(stdlogicVal('Z'), stdlogicVal(ZWLH)) = stdlogicVal(ZWLH) .
  eq resolve(stdlogicVal(ZWLH), stdlogicVal('Z')) = stdlogicVal(ZWLH) .
  eq resolve(stdlogicVal('W'), stdlogicVal(ZWLH)) = stdlogicVal('W') .
  eq resolve(stdlogicVal(ZWLH), stdlogicVal('W')) = stdlogicVal('W') .
  eq resolve(stdlogicVal('L'), stdlogicVal('H')) = stdlogicVal('W') .
  eq resolve(stdlogicVal('H'), stdlogicVal('L')) = stdlogicVal('W') .
  eq resolve(StdLogicVal1, StdLogicVal2) = stdlogicVal('X') [owise] .

  eq (Value1 = Value2) = boolVal(Value1 == Value2) .
  eq (Value1 /= Value2) = boolVal(Value1 =/= Value2) .

  ***eq (BoolVal1 = BoolVal2) = boolVal(BoolVal1 == BoolVal2) .
  ***eq (BoolVal1 /= BoolVal2) = boolVal(BoolVal1 =/= BoolVal2) .
  eq (boolVal(false) < boolVal(true)) = boolVal(true) .
  eq (BoolVal1 < BoolVal2) = boolVal(false) [owise] .
  eq (boolVal(false) "<=" BoolVal2) = boolVal(true) .
  eq (BoolVal1 "<=" BoolVal2) = boolVal(false) [owise] .
  eq (boolVal(true) > boolVal(false)) = boolVal(true) .
  eq (BoolVal1 > BoolVal2) = boolVal(false) [owise] .
  eq (boolVal(true) ">=" BoolVal2) = boolVal(true) .
  eq (BoolVal1 ">=" BoolVal2) = boolVal(false) [owise] .

  ***eq (BitVal1 = BitVal2) = boolVal(BitVal1 == BitVal2) .
  ***eq (BitVal1 /= BitVal2) = boolVal(BitVal1 =/= BitVal2) .
  eq (bitVal('0') < bitVal('1')) = boolVal(true) .
  eq (BitVal1 < BitVal2) = boolVal(false) [owise] .
  eq (bitVal('0') "<=" BitVal2) = boolVal(true) .
  eq (BitVal1 "<=" BitVal2) = boolVal(false) [owise] .
  eq (bitVal('1') > bitVal('0')) = boolVal(true) .
  eq (BitVal1 > BitVal2) = boolVal(false) [owise] .
  eq (bitVal('1') ">=" BitVal2) = boolVal(true) .
  eq (BitVal1 ">=" BitVal2) = boolVal(false) [owise] .

  eq (intVal(Int1) < intVal(Int2)) = boolVal(Int1 < Int2) .
  eq (intVal(Int1) "<=" intVal(Int2)) = boolVal(Int1 <= Int2) .
  eq (intVal(Int1) > intVal(Int2)) = boolVal(Int1 > Int2) .
  eq (intVal(Int1) ">=" intVal(Int2)) = boolVal(Int1 >= Int2) .

  eq (timeVal(R1 TUnit) < timeVal(R2 TUnit)) = boolVal(R1 < R2) .
  eq (timeVal(R1 TUnit) "<=" timeVal(R2 TUnit)) = boolVal(R1 <= R2) .
  eq (timeVal(R1 TUnit) > timeVal(R2 TUnit)) = boolVal(R1 > R2) .
  eq (timeVal(R1 TUnit) ">=" timeVal(R2 TUnit)) = boolVal(R1 >= R2) .


  ***op __ : NumUnOp IntVal -> AExp [ctor] .
  op _+_ : AExp AExp -> AExp [ctor assoc comm] .
  op _-_ : AExp AExp -> AExp [ctor assoc] .
  op _*_ : AExp AExp -> AExp [ctor assoc comm] .
  op _/_ : AExp AExp -> AExp [ctor assoc] .
  op _rem_ : AExp AExp -> AExp [ctor assoc] .
  op _mod_ : AExp AExp -> AExp [ctor assoc] .
  op _**_ : AExp AExp -> AExp [ctor assoc] .
  ***op ___ : IntVal IBinOp IntVal -> AExp [ctor] .
  ***op __ : NumUnOp SignalName -> AExp [ctor] .
  ***op ___ : IntVal IBinOp SignalName -> AExp [ctor] .
  ***op ___ : SignalName IBinOp IntVal -> AExp [ctor] .
  ***op ___ : SignalName IBinOp SignalName -> AExp [ctor] .

  ***eq + intVal(Int1) = intVal(+ Int1) .  
  ***eq - intVal(Int1) = intVal(- Int1) .
  eq abs(intVal(Int1)) = intVal(abs(Int1)) .

  eq intVal(Int1) + intVal(Int2) = intVal(Int1 + Int2) .
  eq intVal(Int1) - intVal(Int2) = intVal(Int1 - Int2) .
  eq intVal(Int1) * intVal(Int2) = intVal(Int1 * Int2) .
  eq intVal(Int1) / intVal(Int2) = intVal(Int1 quo Int2) .
  *** By definition of the Standard: A rem B is the remainder with the sign of A (which coincides with rem operator in Maude).
  eq intVal(Int1) rem intVal(Int2) = intVal(Int1 rem Int2) .
  *** By definition of the Standard: A mod B is the remainder with the sign of B.
  eq intVal(Int1) mod intVal(Int2) = intVal((Int2 / abs(Int2))*(Int1 / abs(Int1))*(Int1 rem Int2)) .
  eq intVal(Int1) ** intVal(Int2) = intVal(Int1 ^ Int2) .

  ***op __ : NumUnOp PhysVal -> AExp [ctor] .
  ***eq - timeVal(R TUnit1) = timeVal((- R) TUnit1) .
  eq abs(timeVal(R TUnit1)) = timeVal(abs(R) TUnit1) .

  ***op ___ : PhysVal PhysNumBinOp PhysVal -> PhysVal [ctor] .
  ***op _+_ : AExp AExp -> AExp [ctor assoc comm] .
  ***op _-_ : AExp AExp -> AExp [ctor assoc] .
  eq timeVal(T1) + timeVal(T2) = timeVal((get-val-time(to-fs(T1)) + get-val-time(to-fs(T2))) fs) .
  eq timeVal(T1) - timeVal(T2) = timeVal((get-val-time(to-fs(T1)) - get-val-time(to-fs(T2))) fs) .

  op get-time : TimeVal -> Time .
  eq get-time(timeVal(T1)) = T1 .

endfm

view Inst; from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to Inst; .
endv

view EntityInstColon from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to EntityInstColon .
endv

view SignalName from TRIV to VHDL-INSTCOLON-MOD is
  sort Elt to SignalName .
endv

fmod VHDL-ATTRIBUTES-MOD is

  protecting VHDL-INSTCOLON-MOD .
  protecting VHDL-VALUE-MOD .

  sorts Attr TypeAttr ObjAttr TOAttr .
  subsorts TOAttr < TypeAttr ObjAttr .

  op _ ' _ : Type TypeAttr -> Value .
  op _ ' _ : SignalName ObjAttr -> Value .
  ***op _ ' _ : VarName ObjAttr -> Value .

  ops ASCENDING LEFT RIGHT HIGH LOW : -> TypeAttr [ctor] .

  var T : Type .
  var IntT : IntType .

  eq IntT ' ASCENDING = boolVal(true) .
  eq 'std_logic ' ASCENDING = boolVal(true) .
  eq bit ' ASCENDING = boolVal(true) .

  eq integer ' LOW = intVal(-2147483648) .
  eq natural ' LOW = natVal(0) .
  eq bit ' LOW = bitVal('0') .
  eq 'std_logic ' LOW = stdlogicVal('U') .

  ceq T ' LEFT = T ' LOW if (T ' ASCENDING) == boolVal(true) .
  eq T ' LEFT = T ' HIGH [owise] .
  
endfm

fmod VHDL-SCHEDULE-MOD is

  protecting VHDL-VALUE-MOD .
  protecting VHDL-INSTCOLON-MOD .

  sorts ScheduledInst SgTimeTuple Transaction SignalState .

  *** An ScheduledInst contains the instruction to be executed and the delay
  *** TODO: check if it would be more accurate to just delay an assignment (delay,sg,value)
  op {scheduledInst: time _, inst _} : Time Inst; -> ScheduledInst [ctor] .

  *** Transactions (ScheduledEvents) relate time and value for a certain signal
  op {sgName _, value _} : SignalName AExp -> SignalState [ctor] .
  op {scheduledEvent: time _, args _} : Time SignalState -> Transaction [ctor] .

  op {sgName _, time _} : SignalName Time -> SgTimeTuple [ctor] .

  var T1 T2 : Time .
  var SgState1 SgState2 : SignalState .
  var Tr1 Tr2 : Transaction .

  op _<_ : Transaction Transaction -> Bool .
  eq {scheduledEvent: time T1, args SgState1} < {scheduledEvent: time T2, args SgState2} = (timeVal(T1) < timeVal(T2) == boolVal(true)) .

  op _<=_ : Transaction Transaction -> Bool .
  eq {scheduledEvent: time T1, args SgState1} <= {scheduledEvent: time T2, args SgState2} = (timeVal(T1) "<=" timeVal(T2) == boolVal(true)) .

endfm

view ScheduledInst from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to ScheduledInst .
endv

view SgTimeTuple from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to SgTimeTuple .
endv

view Transaction from TRIV to VHDL-SCHEDULE-MOD is
  sort Elt to Transaction .
endv

view Transaction<= from TOTAL-ORDER to VHDL-SCHEDULE-MOD is
  sort Elt to Transaction .
endv

mod VHDLMOD is
  *** RAFAEL MORALES PALACIOS - SEMANTICS OF VHDL IN MAUDE
  
  *** IMPORT DATATYPE MODULES TO BE USED
  protecting NAT .
  ***protecting INT .
  ***protecting STRING .
  protecting VHDL-ATTRIBUTES-MOD .
  protecting VHDL-INSTCOLON-MOD .
  protecting VHDL-VALUE-MOD .
  protecting VHDL-GENERIC-MOD .
  protecting MAP{String, Value} .
  protecting MAP{SgTimeTuple, Value} .
  protecting MAP{SignalName, SgDesc} .
  protecting MAP{SignalName, Bool} .
  protecting LIST{Inst;} .
  protecting LIST{EntityInstColon} .
  protecting LIST{SignalName} .
  protecting LIST{ScheduledInst} .
  ***protecting SET{Transaction} .
  protecting SORTABLE-LIST'{Transaction<=} .
  protecting LIST{IOType} .
  protecting LIST{SignalName} .
  protecting LIST{String} .
  
  *** Declare sorts to be used and hierarchy between them.
  sorts VHDLSim VHDLBareSim VHDLCompleteSim Parser ParserTime ParserInsts InputChangeSim InputChangeSimCtrl Code Signal Var Const Clock SimClock ClockPrev Und Error Entity Architecture SgDescStore TimeControlSection ValueStores DescStores . ***sorts VHDLSim Code Entity Port Signal SignalName Var Const VarConstName Value Architecture Process Clock ScheduledInst Und Error .
  sorts Process ProcessSensitivity ProcessNoSensitivity .
  sorts SeqStatement .
  sorts IfThen EndIf ElsifStatement ElseStatement NullStatement .
  sorts EmptyList InstBlock StructuredInstList . ***sorts Inst EmptyList NeList{Inst} List{Inst} InstBlock StructuredInstList .
  ***sorts EventSchSList .
  sorts NeScheduleList ScheduleList NeListeningList ListeningList .
  sorts Assign SignalAssign VarConstAssign .
  sorts Stores NeStore SignalStore VarStore ConstStore .
  sorts EmptyStore NeSignalStore NeVarStore NeConstStore .
  sorts WaitInst SensitivityClause ConditionClause TimeoutClause .



  *** Simulator components
  subsorts Code < VHDLBareSim .

  subsorts ProcessSensitivity ProcessNoSensitivity < Process .
  subsorts Entity Architecture Process Error SeqStatement < Inst .
  subsorts IfThen WaitInst < SeqStatement .
  subsorts NullStatement < ElsifStatement ElseStatement .
  subsorts NullStatement < SensitivityClause ConditionClause TimeoutClause .

  op und : -> Und [ctor] .
  op EmptyList : -> EmptyList [ctor] .
  op error : String -> Error [ctor] .

  op _||_ : List{ScheduledInst} List{Transaction<=} -> TimeControlSection [ctor] .
  op << _ | _ | _ >> : Map{SgTimeTuple, Value} Map{String, Value} Map{String, Value} -> ValueStores [ctor] .
  op < _ > : Map{SignalName, SgDesc} -> DescStores [ctor] .

  op _ # _ : ValueStores DescStores -> Stores [ctor] .

  op [_->_] : List{Inst;} List{ScheduledInst} -> ParserInsts [ctor] .

  op _ _ : ParserInsts Stores -> Parser [ctor] .
  op ! {inputChangeSim: _} : Bool -> InputChangeSim [ctor] . 
  op _ < events: _ > _ : Parser List{Transaction<=} InputChangeSim -> ParserTime [ctor] .

  *** Code represents a whole VHDL file. Rules will be needed for each code statement/block
  op <_|_><_>_ : SimClock List{Inst;} TimeControlSection Stores -> VHDLBareSim [ctor] .
  op ! {inputChangeSimCtrl: _, _} : Bool Time -> InputChangeSimCtrl [ctor] .
  op _ {repeat: _} {wholeExec: _} _ : VHDLBareSim Map{SignalName, Bool} List{ScheduledInst} InputChangeSimCtrl -> VHDLCompleteSim [ctor] .

  op clk : Time -> Clock [ctor] .
  op [prev: _] : Clock -> ClockPrev [ctor] .
  op _ _ : Clock ClockPrev -> SimClock [ctor] .

  *** null is an internal representation for a lack of statement (placeholder)
  op null : -> NullStatement [ctor] .

  *** Instruction ops declarations (that include inner instruction lists)
  
  *** - Entity
  op entity _ is _ end _ : String List{Inst;} String -> Entity [ctor] .
  op entity _ is end _ : String String -> Entity [ctor] .
  
  *** - Architecture
  op architecture _ of _ is _ begin _ end _ : String String List{Inst;} List{Inst;} String -> Architecture [ctor] .
  
  *** - Process
  *** TODO: Variable assignment possibility before begin not included
  op process _ begin _ end process : List{SignalName} List{Inst;} -> ProcessSensitivity [ctor] .
  op process begin _ end process : List{Inst;} -> ProcessNoSensitivity [ctor] .
  op end process : -> Inst [ctor] .

  *** - If statement
  *** TODO: defined precedence
  ***       - Example: red if true then nop ; (elsif true then nop ; elsif true then nop ;) else nop ; end if 
  op end if : -> EndIf [ctor] .
  op if _ then _ _ _ _ : BoolVal List{Inst;} ElsifStatement ElseStatement EndIf -> IfThen [ctor] .
  op if _ then _ _ _ : BoolVal List{Inst;} ElseStatement EndIf -> IfThen [ctor] .
  op if _ then _ _ _ : BoolVal List{Inst;} ElsifStatement EndIf -> IfThen [ctor] .
  op if _ then _ _ : BoolVal List{Inst;} EndIf -> IfThen [ctor] .
  op elsif _ then _ _ : BoolVal List{Inst;} ElsifStatement -> ElsifStatement [ctor] .
  op elsif _ then _ : BoolVal List{Inst;} -> ElsifStatement [ctor] .
  op else _ : List{Inst;} -> ElseStatement [ctor] .
  
  *** Wait statement
  *** Unite all clauses in sort ClauseArgs and make them optional 
  *** op wait _ _ _ : SensitivityClause ConditionClause TimeoutClause -> WaitInst [ctor] .
  *** op wait _ _ : SensitivityClause ConditionClause -> WaitInst [ctor] .
  *** op wait _ _ : SensitivityClause TimeoutClause -> WaitInst [ctor] .
  *** op wait _ _ : ConditionClause TimeoutClause -> WaitInst [ctor] .
  *** op wait _ : SensitivityClause -> WaitInst [ctor] .
  *** op wait _ : ConditionClause -> WaitInst [ctor] .
  *** op wait _ : TimeoutClause -> WaitInst [ctor] .

  ***op on _ : NeList{SignalName} -> SensitivityClause [ctor] .
  ***op until _ : BoolVal -> ConditionClause [ctor] .
  ***op for _ : TimeVal -> TimeoutClause [ctor] .

  *** - Signal (declaration)
  op signal _:_ : NeList{String} Type -> SgDecl [ctor prec 23] .
  op signal _:_:=_ : NeList{String} Type Value -> SgDecl [ctor prec 23] .


  *** lookup: auxiliar op to lookup values from signal store
  op lookup : Map{String, Value} String -> Value .
  *** lookup-sg must be an eq to be able to evaluate it everywhere
  op lookup-sg : Map{SgTimeTuple, Value} SgTimeTuple -> Value .

  *** final_state: final state reachable when max time elapsed is reached
  *** op final_state : VHDLSim -> FinalState .


  *** Variable definition

  vars I1 S1 : Inst; .
  vars SignalId SignalId1 SignalId2 : SignalName .
  var Val Value Value1 Value2 : Value .
  var IL IL1 IL2 : List{Inst;} .
  var NeIL1 NeIL2 : NeList{Inst;} .
  var SgSTR : Map{SgTimeTuple, Value} .
  var SgTimeTuple : SgTimeTuple .
  var STR VarSTR ConstSTR : Map{String, Value} .
  var SgDescSTR : Map{SignalName, SgDesc} .
  var SgDesc : SgDesc .
  var Int1 Int2 : Int .
  var SgStr Str Str2 : String .
  var Clk : SimClock .
  var ClkP1 ClkP2 : Clock .
  var N : Nat .
  var NVal : NatVal .
  var Int : Int .
  var IntVal : IntVal .
  var SchList SchListCp : List{ScheduledInst} .
  var EventSchSList : List{Transaction<=} .
  var NeIODefL : NeList{IODef} .
  var IODef : IODef .
  var IOType : IOType .
  var IOTypeL : List{IOType} .
  var Type Type2 : Type .
  var PhysT : PhysType .
  var IntT : IntType .
  var IODefL : List{IODef} .
  var StdLogicVal StdLogicVal1 StdLogicVal2 : StdLogicVal .
  var BitVal : BitVal .
  var AExp1 AExp2 : AExp .
  var Error : Error .
  vars Op : Op .
  ***var VarType : VarType .
  var NeGenDefL : NeList{GenDef} .
  var GenDefL : List{GenDef} .
  var EntityIL : List{EntityInstColon} .
  vars T Tprev Tnext Tnow Tdelay T' : Time .
  var ClockPrev : ClockPrev .
  var TVal : TimeVal .
  var PosVal : PosVal .
  var NeSgNameL : NeList{SignalName} .
  var SgNameL : List{SignalName} .
  var TControlSect : TimeControlSection .
  var ValStores : ValueStores .
  var SignalState : SignalState .
  var StoresVar : Stores .
  var DescStores : DescStores .
  var B : Bool .
  var SgChangedMap : Map{SignalName, Bool} .
  var SignalIdL : List{SignalName} .
  var ElsifSt : ElsifStatement .
  var ElseSt : ElseStatement .
  var EndIf : EndIf .
  var CompOp : CompOp .
  var BoolVal : BoolVal .
  var SensitivityCl : SensitivityClause .
  var ConditionCl : ConditionClause .
  var TimeoutCl : TimeoutClause .
  var NumUnOp : NumUnOp .
  var IBinOp : IBinOp .
  var InputChangeSim : InputChangeSimCtrl .
  var SgState : SignalState .
  var R1 R2 : Rat .
  var TUnit : TimeUnit .
  var TDelta1 : Delta .
  var SgStrL : List{String} .
  var NeSgStrL : NeList{String} .

  *** Workflow: run(IL, EventSchSList) -> Parse -> insitSimArch -> Simulation Loop
  op run : List{Inst;} List{Transaction<=} Bool -> VHDLCompleteSim [ctor] .
  eq run(IL, EventSchSList, B) = initSimArch(parse(IL) < events: sort(EventSchSList) > ! {inputChangeSim: B}) .
  op run : List{Inst;} List{Transaction<=} -> VHDLCompleteSim [ctor] .
  eq run(IL, EventSchSList) = initSimArch(parse(IL) < events: sort(EventSchSList) > ! {inputChangeSim: false}) .
  op run : List{Inst;} -> VHDLCompleteSim [ctor] .
  eq run(IL) = initSimArch(parse(IL) < events: nil > ! {inputChangeSim: false}) .

  op parse : List{Inst;} -> Parser [ctor] .
  eq parse(IL) = [ IL -> nil ] << empty | empty | empty >> # < empty > .

  op initSimArch : ParserTime -> VHDLCompleteSim [ctor] .
  eq initSimArch([ nil -> SchList ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > < events: EventSchSList > ! {inputChangeSim: B}) = < clk(0 ns) [prev: clk(0 ns)] | nil >< SchList || EventSchSList > << insertDefault(SgDescSTR, SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insertDefaultRep(SgDescSTR, empty) } {wholeExec: SchList} ! {inputChangeSimCtrl: B, 0 ns} .

  op insertDefault : Map{SignalName, SgDesc} Map{SgTimeTuple, Value} -> Map{SgTimeTuple, Value} .
  eq insertDefault(empty, SgSTR) = SgSTR .
  ceq insertDefault(SignalId |-> { IOType $ Type }, SgSTR) = insert({sgName SignalId, time 0 ns}, (Type ' LEFT), SgSTR) if SgSTR[{sgName SignalId, time 0 ns}] == undefined .
  ceq insertDefault((SignalId |-> { IOType $ Type }, SgDescSTR), SgSTR) = insert({sgName SignalId, time 0 ns}, (Type ' LEFT),  insertDefault(SgDescSTR, SgSTR)) if SgSTR[{sgName SignalId, time 0 ns}] == undefined .
  eq insertDefault((SignalId |-> { IOType $ Type }, SgDescSTR), SgSTR) = insertDefault(SgDescSTR, SgSTR) [owise] .

  op insertDefaultRep : Map{SignalName, SgDesc} Map{SignalName, Bool} -> Map{SignalName, Bool} .
  eq insertDefaultRep(SignalId |-> { IOType $ Type }, SgChangedMap) = insert(SignalId, false,  SgChangedMap) .
  eq insertDefaultRep((SignalId |-> { IOType $ Type }, SgDescSTR), SgChangedMap) = insert(SignalId, false,  insertDefaultRep(SgDescSTR, SgChangedMap)) .

  ***op initSim : List{Inst;} List{Transaction<=} -> VHDLSim [ctor] .
  ***eq initSim(IL, EventSchSList) = < clk(0 ns) [prev: clk(0 ns)] | IL >< nil | nil | EventSchSList > << empty | empty | empty >> # < empty > .

  *** An entity declared without instructions is equivalent to an entity with an empty list of instructions
  eq entity Str is end Str = entity Str is nil end Str .
  *** A process declared without a sensitivity list is equal to the process with an empty sensitivity list 
  eq process begin IL end process = process nil begin IL end process .
  
  *** An if statement can have any number of elsif sub-statements and 0 or 1 else statements
  eq if BoolVal then IL EndIf = if BoolVal then IL null null EndIf .
  eq if BoolVal then IL ElseSt EndIf = if BoolVal then IL null ElseSt EndIf .
  eq if BoolVal then IL ElsifSt EndIf = if BoolVal then IL ElsifSt null EndIf .
  eq elsif BoolVal then IL = elsif BoolVal then IL null .

  ***eq wait ConditionCl TimeoutCl = wait null ConditionCl TimeoutCl .
  ***eq wait SensitivityCl TimeoutCl = wait SensitivityCl null TimeoutCl .
  ***eq wait SensitivityCl ConditionCl = wait SensitivityCl ConditionCl null .

  *** A signal declaration with no default expression takes the default value for its type (T'LEFT)
  eq signal NeSgStrL : Type = signal NeSgStrL : Type := (Type ' LEFT) .

  *** A signal assignment assumes 0 ns delay if after clause is not present
  eq SignalId <= AExp1 = SignalId <= AExp1 after (0 ns) .

  *** TODO: Restrict values of SgSTR to StdLogic with cmb

  *** Rules

  *** Non-deterministic change of signal values
  *** TODO:
  *** - Optionality
  *** - Restrict where it could happen
  *** - Take into account that when activating
  ***crl [nd-sg-val-change] : < clk(R1 TUnit) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << ({sgName SignalId, time (R1 TUnit)} |-> StdLogicVal , SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} ! {inputChangeSimCtrl: true , (R2 TUnit) }
  ***                        => 
  ***                        < clk(R1 TUnit) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << insert({sgName SignalId, time (R1 TUnit) + delta}, correctVal(not StdLogicVal, SignalId, lookup-sg(SgSTR, {sgName SignalId, time (R1 TUnit) + delta})), SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalId,  (sg-val-changed(correctVal(not StdLogicVal, SignalId, lookup-sg(SgSTR, {sgName SignalId, time (R1 TUnit) + delta})), SignalId, (R1 TUnit), SgSTR)), SgChangedMap) } {wholeExec: SchListCp} ! {inputChangeSimCtrl: true , (R1 TUnit) }
  ***                        if verify-sg(in inout, SignalId, SgDescSTR) and R1 =/= R2 . ***T =/= T' and T =/= T' + delta and T =/= T' + delta(2) .
  ***crl [nd-sg-val-change-bis] : < clk(R1 TUnit + TDelta1) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << ({sgName SignalId, time (R1 TUnit + TDelta1)} |-> StdLogicVal , SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} ! {inputChangeSimCtrl: true , (R2 TUnit) }
  ***                        => 
  ***                        < clk(R1 TUnit + TDelta1) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << insert({sgName SignalId, time (R1 TUnit + TDelta1) + delta}, correctVal(not StdLogicVal, SignalId, lookup-sg(SgSTR, {sgName SignalId, time (R1 TUnit + TDelta1) + delta})), SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalId,  (sg-val-changed(correctVal(not StdLogicVal, SignalId, lookup-sg(SgSTR, {sgName SignalId, time (R1 TUnit + TDelta1) + delta})), SignalId, (R1 TUnit + TDelta1), SgSTR)), SgChangedMap) } {wholeExec: SchListCp} ! {inputChangeSimCtrl: true , (R1 TUnit) }
  ***                        if verify-sg(in inout, SignalId, SgDescSTR) and R1 =/= R2 .

  rl [parse-entity] : [ (entity Str is IL1 end Str) ; IL -> SchList ]
                      => 
                      [ IL1 exit-block(IL) -> SchList ] .

  rl [parse-port] : [ (port(NeIODefL)) ; IL -> SchList ]
                    => 
                    [ get-port-sg(NeIODefL) ; exit-block(IL) -> SchList ] .
  rl [parse-get-port-sg] : [ (get-port-sg((Str : IOType Type ;) IODefL)) ; exit-block(IL) -> SchList ] ValStores # < SgDescSTR > 
                     => 
                     [ get-port-sg(IODefL) ; exit-block(IL) -> SchList ] ValStores # < insert(sg(Str), { IOType $ Type }, SgDescSTR) > .

  rl [parse-generic] : [ (generic(NeGenDefL)) ; IL -> SchList ]
                => 
                [ get-gen(NeGenDefL) ; exit-block(IL) -> SchList ] .
  crl [parse-get-gen] : [ (get-gen((Str : Type := Val ;) GenDefL)) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | ConstSTR >> # DescStores
                =>
                [ get-gen(GenDefL) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | insert(Str, Val, ConstSTR) >> # DescStores 
                if verify-typeVal(Type, Val) .

  crl [parse-signal] : [ (signal NeSgStrL : Type := Value) ; IL -> SchList ]
                => 
                [ decl-sg(NeSgStrL, Type, Value) ; exit-block(IL) -> SchList ]
                if verify-typeVal(Type, Value) .
  
  rl [parse-decl-sg] : [ decl-sg(SgStr SgStrL, Type, Value) ; exit-block(IL) -> SchList ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR >
                =>
                [ decl-sg(SgStrL, Type, Value) ; exit-block(IL) -> SchList ] << insert({sgName sg(SgStr), time 0 ns}, Value, SgSTR) | VarSTR | ConstSTR >> # < insert(sg(SgStr), { inout $ Type}, SgDescSTR) > .

  rl [parse-architecture] : [ (architecture Str of Str2 is IL1 begin IL2 end Str) ; IL -> SchList ] StoresVar
                          => 
                          [ IL1 exit-block(IL2 exit-block(IL)) -> SchList ] StoresVar .  
                          
  crl [parse-process] : [ (process SgNameL begin IL2 end process) ; IL -> SchList ]
                    => 
                    [ IL -> SchList {scheduledInst: time 0 ns, inst (process SgNameL begin IL2 end process) ;} ]
                    if verify-typeBlock(IL2) .

  crl [parse-assign-sg-val] : [ (SignalId <= AExp1 after Tdelay) ; IL -> SchList ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > 
                            => 
                            [ IL -> SchList {scheduledInst: time 0 ns, inst (SignalId <= AExp1 after Tdelay) ;} ] << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > 
                            if verify-sg(out inout, SignalId, SgDescSTR) and verify-typeAssignment(SignalId, AExp1, SgDescSTR) .
  
  crl [parse-if-then] : [(if BoolVal then IL ElsifSt ElseSt EndIf) ; IL -> SchList ] 
                        =>
                        [IL -> SchList ]
                        if verify-typeBlock(IL) and verify-typeElsifSt(ElsifSt) and verify-typeElseSt(ElseSt) .

  *** assign-sg-val : assign a value to a signal after solving all AExp and signal lookups
  rl [assign-sg-val-sch] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (SignalId <= AExp1 after Tdelay) ;}  SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                      => 
                      if Tdelay == (0 ns) then
                        < clk(T) [prev: clk(Tprev)] | nil >< SchList || EventSchSList > << insert({sgName SignalId, time T + delta}, correctVal(evalA(AExp1, T, SgSTR), SignalId, lookup-sg(SgSTR, {sgName SignalId, time T + delta})), SgSTR) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalId,  (sg-val-changed(correctVal(evalA(AExp1, T, SgSTR), SignalId, lookup-sg(SgSTR, {sgName SignalId, time T + delta})), SignalId, T, SgSTR)), SgChangedMap) } {wholeExec: SchListCp} InputChangeSim
                      else
                        < clk(T) [prev: clk(Tprev)] | nil >< SchList || sort({scheduledEvent: time get-time(timeVal(T) + timeVal(Tdelay)), args {sgName SignalId, value AExp1}} EventSchSList) > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                      fi .
  rl [process] : < clk(T) ClockPrev | nil >< {scheduledInst: time T, inst (process SgNameL begin IL2 end process) ;}  SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # DescStores 
                => 
                if processSensitivityActivate(clk(T) ClockPrev, SgNameL, SgSTR)
                then
                  < clk(T) ClockPrev | nil >< unfold(IL2, T) SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # DescStores
                else
                 < clk(T) ClockPrev | nil >< SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # DescStores
                fi .
  rl [if-then] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time T, inst (if BoolVal then IL ElsifSt ElseSt EndIf) ;}  SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # DescStores {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                => 
                if (evalB(BoolVal, T, SgSTR) == boolVal(true)) then
                  < clk(T) [prev: clk(Tprev)] | nil >< unfold(IL, T) SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # DescStores {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                else
                  < clk(T) [prev: clk(Tprev)] | nil >< unfold(schRestIf(ElsifSt, ElseSt), T) SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # DescStores {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                fi .

  ***rl [end-parse] : [ nil -> SchList ] StoresVar < events: EventSchSList >
  ***                =>
  ***                initSimArch([ nil -> SchList ] StoresVar < events: EventSchSList >) .

  crl [end-sim-cycle-delta] : < clk(T) [prev: clk(Tprev)] | nil >< nil || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                                    => 
                                    < clk(T + delta) [prev: clk(T)] | nil >< schOnTime(SchListCp, T + delta) || EventSchSList > << fill-blanks(get-sgL(SgDescSTR), SgSTR, T + delta, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insertDefaultRep(SgDescSTR, SgChangedMap) } {wholeExec: SchListCp} InputChangeSim
                                    if anySgChange(SgChangedMap) == true .
  crl [end-sim-cycle-delta-nextEv] : < clk(T) [prev: clk(Tprev)] | nil >< {scheduledInst: time Tnext, inst I1 } SchList || EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                            => 
                            < clk(T + delta) [prev: clk(T)] | nil >< schOnTime(SchListCp, T + delta) {scheduledInst: time Tnext, inst I1 } SchList || EventSchSList > << fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insertDefaultRep(SgDescSTR, SgChangedMap) } {wholeExec: SchListCp} InputChangeSim
                            if anySgChange(SgChangedMap) == true and T =/= Tnext .
  crl [end-sim-cycle-nextEv-last] : < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName SignalId, value AExp1} } > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                                  => 
                                    < clk(Tnext) [prev: clk(T)] | nil >< schOnTime(SchListCp, Tnext) || nil > << fill-blanks-next-ev(SignalId, get-sgL(SgDescSTR), insert({sgName SignalId, time Tnext}, evalA(AExp1, T, SgSTR), fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalId, true, sgChangeOnEv(T, Tnext, SgSTR, get-sgL(SgDescSTR), SgChangedMap)) } {wholeExec: SchListCp} InputChangeSim
                                  if anySgChange(SgChangedMap) == false and T =/= Tnext .
  crl [end-sim-cycle-nextEv] : < clk(T) [prev: clk(Tprev)] | nil >< nil || {scheduledEvent: time Tnext, args {sgName SignalId, value AExp1} } {scheduledEvent: time T', args SgState } EventSchSList > << SgSTR | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                            => 
                            if (Tnext == T') then
                              < clk(T) [prev: clk(Tprev)] | nil >< nil || ({scheduledEvent: time T', args SgState } EventSchSList) > << insert({sgName SignalId, time Tnext}, evalA(AExp1, T, SgSTR), fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: SgChangedMap } {wholeExec: SchListCp} InputChangeSim
                            else
                              < clk(Tnext) [prev: clk(T)] | nil >< schOnTime(SchListCp, Tnext) || ({scheduledEvent: time T', args SgState } EventSchSList) > << fill-blanks-next-ev(SignalId, get-sgL(SgDescSTR), insert({sgName SignalId, time Tnext}, evalA(AExp1, T, SgSTR), fill-blanks(get-sgL(SgDescSTR), SgSTR, T, Tprev)), Tnext, T) | VarSTR | ConstSTR >> # < SgDescSTR > {repeat: insert(SignalId, true, SgChangedMap) } {wholeExec: SchListCp} InputChangeSim
                            fi
                            if anySgChange(SgChangedMap) == false and T =/= Tnext .


  *** nop: test instruction
  rl [nop] : nop ; IL => IL .


  *** exit-block: exit an inner block and continue where left before
  rl [exit-block] : < Clk | exit-block(IL) >< TControlSect > ValStores # DescStores 
                    => 
                    < Clk | IL >< TControlSect > ValStores # DescStores .
  
  rl [parse-exit-block] : [ exit-block(IL) -> SchList ]
                => 
                [ IL -> SchList ] .

  ***rl [error] : < Clk | Error ; IL >< TControlSect > ValStores # DescStores => Error ; .

  *** List{Inst} operations 
  op head : NeList{Inst;} -> Inst; .
  eq head(I1 IL) = I1 .

  op tail : NeList{Inst;} -> List{Inst;} .
  eq tail(I1 IL) = IL .

  op exit-block : List{Inst;} -> List{Inst;} .
  ***eq exit-block(IL) = IL .

  op get-port-sg : List{IODef} -> Inst [ctor] .
  eq get-port-sg(nil) = nop .

  op get-sgIOtype : SgDesc -> IOType .
  eq get-sgIOtype({IOType $ Type}) = IOType .
  op get-sgType : SgDesc -> Type .
  eq get-sgType({IOType $ Type}) = Type .

  op get-gen : List{GenDef} -> Inst [ctor] .
  eq get-gen(nil) = nop .

  op decl-sg : List{String} Type Value -> Inst [ctor] .
  eq decl-sg(nil, Type, Value) = nop .

  op unfold : List{Inst;} Time -> List{ScheduledInst} [ctor] .
  eq unfold(nil, T) = nil .
  eq unfold(I1 IL, T) = {scheduledInst: time T, inst I1} unfold(IL, T) .

  op processSensitivityActivate : SimClock List{SignalName} Map{SgTimeTuple, Value} -> Bool .
  eq processSensitivityActivate(Clk, nil, SgSTR) = true .
  eq processSensitivityActivate(clk(0 ns) [prev: clk(0 ns)], NeSgNameL, SgSTR) = true .
  eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], SignalId1, SgSTR) = lookup-sg(SgSTR, {sgName SignalId1, time T}) =/= lookup-sg(SgSTR, {sgName SignalId1, time Tprev}) .
  eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], SignalId1 NeSgNameL, SgSTR) = processSensitivityActivate(clk(T) [prev: clk(Tprev)], SignalId1, SgSTR) or processSensitivityActivate(clk(T) [prev: clk(Tprev)], NeSgNameL, SgSTR) .
  eq processSensitivityActivate(clk(T) [prev: clk(Tprev)], NeSgNameL, SgSTR) = false [owise] .

  op sg-val-changed : Value SignalName Time Map{SgTimeTuple, Value} -> Bool .
  eq sg-val-changed(Value, SignalId, T, SgSTR) = (Value =/= lookup-sg(SgSTR, {sgName SignalId, time T})) .
  ***eq sg-val-changed(Value, SignalId, T, SgSTR) = false [owise] .

  op schOnTime : List{ScheduledInst} Time -> List{ScheduledInst} [ctor] .
  eq schOnTime(nil, Tnow) = nil .
  eq schOnTime({scheduledInst: time T, inst I1 } SchList, Tnow) =  {scheduledInst: time Tnow, inst I1 } schOnTime(SchList, Tnow) .

  *** Resolve multiple assignments: first Value is newValue, second is already assigned value
  op correctVal : Value SignalName Value -> Value .
  eq correctVal(Value, SignalId, undefined) = Value .
  eq correctVal(Value, SignalId, Value) = Value .
  ***if lookup-sg(SgSTR, {sgName sg(SgStr), time T + delta}) == undefined or lookup-sg(SgSTR, {sgName sg(SgStr), time T}) == stdlogicVal('U') .
  eq correctVal(Value, SignalId, Value1) = resolve(Value, Value1) [owise] .

  op anySgChange : Map{SignalName, Bool} -> Bool .
  eq anySgChange(empty) = false .
  eq anySgChange((SignalId |-> true, SgChangedMap)) = true .
  eq anySgChange((SignalId |-> false, SgChangedMap)) = anySgChange(SgChangedMap) .

  op fill-blanks : List{SignalName} Map{SgTimeTuple, Value} Time Time -> Map{SgTimeTuple, Value} .
  eq fill-blanks(nil, SgSTR, T, Tprev) = SgSTR .
  ceq fill-blanks(SignalId1 SignalIdL, SgSTR, T, Tprev) = insert({sgName SignalId1, time T}, SgSTR[{sgName SignalId1, time Tprev}], fill-blanks(SignalIdL, SgSTR, T, Tprev)) if SgSTR[{sgName SignalId1, time T}] == undefined .
  eq fill-blanks(SignalId1 SignalIdL, SgSTR, T, Tprev) = fill-blanks(SignalIdL, SgSTR, T, Tprev) .

  op fill-blanks-next-ev : SignalName List{SignalName} Map{SgTimeTuple, Value} Time Time -> Map{SgTimeTuple, Value} .
  eq fill-blanks-next-ev(SignalId, nil, SgSTR, Tnext, T) = SgSTR .
  eq fill-blanks-next-ev(SignalId, SignalId SignalIdL, SgSTR, Tnext, T) = fill-blanks-next-ev(SignalId, SignalIdL, SgSTR, Tnext, T) .
  ceq fill-blanks-next-ev(SignalId, SignalId1 SignalIdL, SgSTR, Tnext, T) = insert({sgName SignalId1, time Tnext}, SgSTR[{sgName SignalId1, time T}], fill-blanks(SignalIdL, SgSTR, Tnext, T)) if SgSTR[{sgName SignalId1, time Tnext}] == undefined and SignalId =/= SignalId1 .
  eq fill-blanks-next-ev(SignalId, SignalId1 SignalIdL, SgSTR, Tnext, T) = fill-blanks-next-ev(SignalId, SignalIdL, SgSTR, Tnext, T) [owise] .

  op get-sgL : Map{SignalName, SgDesc} -> List{SignalName} .
  eq get-sgL(empty) = nil .
  eq get-sgL((SignalId |-> SgDesc, SgDescSTR)) = SignalId get-sgL(SgDescSTR) .

  op schRestIf : ElsifStatement ElseStatement -> List{Inst;} .
  eq schRestIf(null, null) = nil .
  eq schRestIf(null, else IL) = IL .
  eq schRestIf(elsif boolVal(true) then IL ElsifSt, ElseSt) = IL .
  eq schRestIf(elsif boolVal(false) then IL ElsifSt, ElseSt) = schRestIf(ElsifSt, ElseSt) .

  op sgChangeOnEv : Time Time Map{SgTimeTuple, Value} List{SignalName} Map{SignalName, Bool} -> Map{SignalName, Bool} .
  eq sgChangeOnEv(T, Tnext, SgSTR, nil, SgChangedMap) = SgChangedMap .
  ceq sgChangeOnEv(T, Tnext, SgSTR, SignalId SignalIdL, SgChangedMap) = insert(SignalId, (sg-val-changed(SgSTR[{sgName SignalId, time Tnext}], SignalId, T, SgSTR)), sgChangeOnEv(T, Tnext, SgSTR, SignalIdL, SgChangedMap)) if SgSTR[{sgName SignalId, time Tnext}] =/= undefined .
  eq sgChangeOnEv(T, Tnext, SgSTR, SignalId SignalIdL, SgChangedMap) = sgChangeOnEv(T, Tnext, SgSTR, SignalIdL, SgChangedMap) .

  *** ------------
  
  *** lookup signal from signal store
  eq lookup-sg(SgSTR, SgTimeTuple) = SgSTR[SgTimeTuple] .
  eq lookup(STR, Str) = STR[Str] .

  op evalB : BoolVal Time Map{SgTimeTuple, Value} -> BoolVal .
  eq evalB(boolVal(true), T, SgSTR) = boolVal(true) .
  eq evalB(boolVal(false), T, SgSTR) = boolVal(false) .
  eq evalB(SignalId, T, SgSTR) = SgSTR[{sgName SignalId, time T}] .
  ***eq evalB(SignalId CompOp AExp1, T, SgSTR) = SgSTR[{sgName SignalId, time T}] CompOp AExp1 .
  ***eq evalB(AExp1 CompOp SignalId, T, SgSTR) = AExp1 CompOp SgSTR[{sgName SignalId, time T}] .
  ***eq evalB(SignalId1 CompOp SignalId2, T, SgSTR) = SgSTR[{sgName SignalId1, time T}] CompOp SgSTR[{sgName SignalId2, time T}] .
  eq evalB(AExp1 CompOp AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) CompOp evalA(AExp2, T, SgSTR) .

  ***op __ : NumUnOp SignalName -> IntVal [ctor] .
  ***op ___ : SignalName IBinOp SignalName -> IntVal [ctor] .

  op evalA : AExp Time Map{SgTimeTuple, Value} -> Value .
  eq evalA(Value, T, SgSTR) = Value .
  eq evalA(SignalId, T, SgSTR) = SgSTR[{sgName SignalId, time T}] .
  eq evalA(not SignalId, T, SgSTR) = not (SgSTR[{sgName SignalId, time T}]) .
  eq evalA(abs(SignalId), T, SgSTR) = abs(SgSTR[{sgName SignalId, time T}]) .

  eq evalA(AExp1 and AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) and evalA(AExp2, T, SgSTR) .
  eq evalA(AExp1 or AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) or evalA(AExp2, T, SgSTR) .
  eq evalA(AExp1 xor AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) xor evalA(AExp2, T, SgSTR) .

  eq evalA(AExp1 + AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) + evalA(AExp2, T, SgSTR) .
  eq evalA(AExp1 - AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) - evalA(AExp2, T, SgSTR) .
  eq evalA(AExp1 * AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) * evalA(AExp2, T, SgSTR) .
  eq evalA(AExp1 / AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) / evalA(AExp2, T, SgSTR) .
  eq evalA(AExp1 rem AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) rem evalA(AExp2, T, SgSTR) .
  eq evalA(AExp1 mod AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) mod evalA(AExp2, T, SgSTR) .
  eq evalA(AExp1 ** AExp2, T, SgSTR) = evalA(AExp1, T, SgSTR) ** evalA(AExp2, T, SgSTR) .

  ***--------------------------
  *** VERIFICATION
  ***--------------------------
  *** verify-sg: auxilar op to verify signal types on instructions
  op verify-sg : List{IOType} SignalName Map{SignalName, SgDesc} -> Bool [ctor] .
  eq verify-sg(IOType IOTypeL, SignalId, SgDescSTR) = (IOType == get-sgIOtype(SgDescSTR[SignalId]) or verify-sg(IOTypeL, SignalId, SgDescSTR)) .
  eq verify-sg(IOTypeL, SignalId, SgDescSTR) = false [owise] .
  
  *** verify-typeVal : auxiliary op to verify value types
  op verify-typeVal : Type Value -> Bool [ctor] .
  eq verify-typeVal(bool, BoolVal) = true .
  eq verify-typeVal(bit, BitVal) = true .
  eq verify-typeVal('std_logic, StdLogicVal) = true .
  eq verify-typeVal(natural, NVal) = true .
  eq verify-typeVal(integer, IntVal) = true .
  eq verify-typeVal(time, TVal) = true .
  eq verify-typeVal(positive, PosVal) = true .
  eq verify-typeVal(Type, Val) = false [owise] .

  *** verify-typeAssignment : auxiliary op to verify has correct type in signal assignment
  op verify-typeAssignment : SignalName AExp Map{SignalName, SgDesc} -> Bool .
  ceq verify-typeAssignment(SignalId, AExp1, SgDescSTR) = 
      verify-typeAExp(Type, AExp1, SgDescSTR) 
    if {IOType $ Type} := SgDescSTR[SignalId] .
  eq verify-typeAssignment(SignalId, AExp1, SgDescSTR) = false [owise] .
  
  *** verify-typeAExp : auxiliary op to type-check AExp
  op verify-typeAExp : Type AExp Map{SignalName, SgDesc} -> Bool .
  eq verify-typeAExp(Type, Val, SgDescSTR) = verify-typeVal(Type, Val) .
  ceq verify-typeAExp(Type, SignalId, SgDescSTR) = 
      Type == Type2
    if {IOType $ Type2} := SgDescSTR[SignalId] .
  eq verify-typeAExp(Type, not AExp1, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) .
  eq verify-typeAExp(Type, abs(AExp1), SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) .
  eq verify-typeAExp(Type, AExp1 and AExp2, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) and verify-typeAExp(Type, AExp2, SgDescSTR) .
  eq verify-typeAExp(Type, AExp1 or AExp2, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) and verify-typeAExp(Type, AExp2, SgDescSTR) .
  eq verify-typeAExp(Type, AExp1 xor AExp2, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) and verify-typeAExp(Type, AExp2, SgDescSTR) .

  eq verify-typeAExp(Type, AExp1 + AExp2, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) and verify-typeAExp(Type, AExp2, SgDescSTR) .
  eq verify-typeAExp(Type, AExp1 - AExp2, SgDescSTR) = verify-typeAExp(Type, AExp1, SgDescSTR) and verify-typeAExp(Type, AExp2, SgDescSTR) .
  eq verify-typeAExp(IntT, AExp1 * AExp2, SgDescSTR) = verify-typeAExp(IntT, AExp1, SgDescSTR) and verify-typeAExp(IntT, AExp2, SgDescSTR) .
  eq verify-typeAExp(PhysT, AExp1 * AExp2, SgDescSTR) = 
                                                  (verify-typeAExp(integer, AExp1, SgDescSTR) and verify-typeAExp(PhysT, AExp2, SgDescSTR))
                                                  or (verify-typeAExp(PhysT, AExp1, SgDescSTR) and verify-typeAExp(integer, AExp2, SgDescSTR)) .
  eq verify-typeAExp(IntT, AExp1 / AExp2, SgDescSTR) = verify-typeAExp(IntT, AExp1, SgDescSTR) and verify-typeAExp(IntT, AExp2, SgDescSTR) .
  eq verify-typeAExp(PhysT, AExp1 / AExp2, SgDescSTR) = verify-typeAExp(PhysT, AExp1, SgDescSTR) and verify-typeAExp(integer, AExp2, SgDescSTR) .
  eq verify-typeAExp(PhysT, AExp1 / AExp2, SgDescSTR) = verify-typeAExp(PhysT, AExp1, SgDescSTR) and verify-typeAExp(PhysT, AExp2, SgDescSTR) .
  eq verify-typeAExp(IntT, AExp1 rem AExp2, SgDescSTR) = verify-typeAExp(IntT, AExp1, SgDescSTR) and verify-typeAExp(IntT, AExp2, SgDescSTR) .
  eq verify-typeAExp(IntT, AExp1 mod AExp2, SgDescSTR) = verify-typeAExp(IntT, AExp1, SgDescSTR) and verify-typeAExp(IntT, AExp2, SgDescSTR) .
  eq verify-typeAExp(PhysT, AExp1 rem AExp2, SgDescSTR) = verify-typeAExp(PhysT, AExp1, SgDescSTR) and verify-typeAExp(PhysT, AExp2, SgDescSTR) .
  eq verify-typeAExp(PhysT, AExp1 mod AExp2, SgDescSTR) = verify-typeAExp(PhysT, AExp1, SgDescSTR) and verify-typeAExp(PhysT, AExp2, SgDescSTR) .
  eq verify-typeAExp(IntT, AExp1 ** AExp2, SgDescSTR) = verify-typeAExp(IntT, AExp1, SgDescSTR) and verify-typeAExp(integer, AExp2, SgDescSTR) .
  *** For the case of comparison operators, signals have and values at each side shall have the same value
  eq verify-typeAExp(bool, AExp1 CompOp AExp2, SgDescSTR) = verify-sameType(AExp1, AExp2, SgDescSTR) .
  ***eq verify-typeAExp(bool, SignalId1 CompOp SignalId2, SgDescSTR) = verify-typeAExp(get-sgType(SgDescSTR[SignalId1]), SignalId1, SgDescSTR) and verify-typeAExp(get-sgType(SgDescSTR[SignalId1]), SignalId2, SgDescSTR) .

  op verify-sameType : AExp AExp Map{SignalName, SgDesc} -> Bool .
  eq verify-sameType(AExp1, AExp2, SgDescSTR) = (verify-typeAExp(bit, AExp1, SgDescSTR) and verify-typeAExp(bit, AExp2, SgDescSTR))
                                             or (verify-typeAExp('std_logic, AExp1, SgDescSTR) and verify-typeAExp('std_logic, AExp2, SgDescSTR))
                                             or (verify-typeAExp(integer, AExp1, SgDescSTR) and verify-typeAExp(integer, AExp2, SgDescSTR))
                                             or (verify-typeAExp(bool, AExp1, SgDescSTR) and verify-typeAExp(bool, AExp2, SgDescSTR))
                                             or (verify-typeAExp(time, AExp1, SgDescSTR) and verify-typeAExp(time, AExp2, SgDescSTR))
                                             or (verify-typeAExp(natural, AExp1, SgDescSTR) and verify-typeAExp(natural, AExp2, SgDescSTR)) .

  *** verify-typeBlock : auxiliary op to type-check instructions in an internal instruction list
  op verify-typeBlock : List{Inst;} -> Bool .
  eq verify-typeBlock(IL) = true .
  eq verify-typeBlock(IL) = verify-parseValid(parse(IL)) .

  op verify-parseValid : Parser -> Bool .
  eq verify-parseValid([ nil -> SchList ] StoresVar) = true .
  eq verify-parseValid([ IL -> SchList ] StoresVar) = false [owise] .

  *** verify if-elsif-else statement
  op verify-typeElsifSt : ElsifStatement -> Bool .
  eq verify-typeElsifSt(null) = true .
  eq verify-typeElsifSt(elsif BoolVal then IL) = verify-typeBlock(IL) .
  eq verify-typeElsifSt(elsif BoolVal then IL ElsifSt) = verify-typeBlock(IL) and verify-typeElsifSt(ElsifSt) .

  op verify-typeElseSt : ElseStatement -> Bool .
  eq verify-typeElseSt(null) = true .
  eq verify-typeElsifSt(else IL) = verify-typeBlock(IL) .
  
endm

